import { Theme } from "../theme.slint";

// The PIN a browser needs before it can edit the house.
//
// Deliberately the loudest thing the GUI ever draws: it is read across a room,
// off a 480px panel, by someone holding a phone in the other hand. It also
// doubles as the alarm - if this appears and nobody opened the page, somebody
// else on the network just tried to.
export component PairOverlay inherits Rectangle {
    in property <bool> shown: false;
    in property <string> pin: "";
    in property <int> seconds-left: 0;

    visible: root.shown;
    background: Theme.scrim;
    // The PIN covers the controls below; touches must not fall through to them.
    TouchArea { enabled: root.shown; }

    VerticalLayout {
        alignment: center;
        spacing: 18px;
        padding-left: 28px;
        padding-right: 28px;

        Text {
            text: "PAIR THIS DEVICE";
            font-size: 15px;
            letter-spacing: 2px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 84px;
            background: Theme.surface-raised;
            border-radius: Theme.r-card;
            border-width: 1px;
            border-color: Theme.accent;
            Text {
                text: root.pin;
                // 48px keeps the PIN readable while the remote is in hand.
                // This size originally also reduced the per-size bitmap font
                // payload; SDF now shares one glyph set across sizes.
                font-size: 48px;
                font-weight: 700;
                letter-spacing: 8px;
                color: Theme.accent;
            }
        }

        Text {
            text: "Enter this in the browser";
            font-size: 19px;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.seconds-left > 0
                ? "Expires in " + root.seconds-left + "s"
                : "Expired";
            font-size: 15px;
            color: Theme.text-quaternary;
            horizontal-alignment: center;
        }
    }
}
