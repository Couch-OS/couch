import { Theme } from "../theme.slint";
import { NoticeCard } from "notice_card.slint";

// Shown while the microphone is open, and for a moment afterwards with what
// Home Assistant heard and said.
//
// Unmissable on purpose. A device with a microphone in someone's living room
// owes them an obvious answer to "is it listening", and a discreet indicator is
// a worse answer than none - it trains people not to look. The red bar and the
// meter are driven from the capture thread's own liveness, so they cannot be
// lit while the microphone is shut, or dark while it is open. Once the device
// is closed the card turns to the result, in the accent, with no red anywhere.
export component MicOverlay inherits Rectangle {
    in property <bool> shown: false;
    /// The microphone is open. Red while true; never red otherwise.
    in property <bool> recording: false;
    in property <float> level;      // 0..1
    /// Tapped rather than held, so it stays on until the next press.
    in property <bool> latched: false;
    /// "connecting" | "listening" | "thinking" | "done" | "failed".
    in property <string> phase: "listening";
    in property <string> phase-label: "LISTENING";
    /// "keyboard" while dictating into the on-screen keyboard.
    in property <string> target: "assistant";
    in property <string> heard;
    in property <string> said;
    in property <string> detail;    // an error, or where the audio goes

    visible: root.shown;
    background: #000000E0;

    property <color> tone: root.recording ? #E04030 : root.phase == "failed" ? Theme.text-tertiary : Theme.accent;

    VerticalLayout {
        alignment: center;
        spacing: 20px;
        padding-left: 34px;
        padding-right: 34px;

        NoticeCard { tone: root.tone; word: root.phase-label; }

        // The meter is the honest part: it moves with what the capsule hears,
        // so a microphone that is open but deaf looks different from one that
        // is working. It is only there while the device is.
        if root.recording: Rectangle {
            height: 12px;
            background: Theme.surface;
            border-radius: 6px;
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * max(0.0, min(1.0, root.level));
                height: parent.height;
                border-radius: 6px;
                background: Theme.accent;
            }
        }

        // What was heard, and what came back. Filled in as the events arrive,
        // so a transcript shows while the assistant is still thinking.
        if root.heard != "": Text {
            text: "“" + root.heard + "”";
            font-size: 23px;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if root.said != "": Text {
            text: root.said;
            font-size: 21px;
            color: Theme.accent;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: 18px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        Text {
            text: root.recording
                ? (root.latched ? "Press the mic key again to finish." : "Release the mic key to finish.")
                  + (root.target == "keyboard" ? "  Your words go into the keyboard." : "")
                : root.phase == "thinking" ? "Waiting for Home Assistant…"
                : root.target == "keyboard" && root.phase == "done" ? "Added to the keyboard."
                : "";
            font-size: 19px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
