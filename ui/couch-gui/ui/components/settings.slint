import { Theme } from "../theme.slint";
import { FocusRing } from "focus_ring.slint";

// One labelled row with a value on the right. `stepper` draws the value between
// Lucide's big left and right arrows, the cue that left and right change it;
// `arrow` draws one big right arrow, the cue that OK opens or runs the row.
component SettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <bool> stepper: true;
    in property <bool> arrow: false;

    height: 72px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.r-card;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        Text {
            vertical-alignment: center;
            horizontal-stretch: 1;
            text: root.title;
            font-size: 21px;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
        if root.stepper: VerticalLayout {
            alignment: center;
            Image { width: 24px; height: 24px; source: @image-url("../../../../assets/lucide/arrow-big-left.svg"); colorize: Theme.text-tertiary; }
        }
        if root.value != "": Text {
            vertical-alignment: center;
            text: root.value;
            font-size: 21px;
            color: Theme.accent;
        }
        if root.stepper || root.arrow: VerticalLayout {
            alignment: center;
            Image { width: 24px; height: 24px; source: @image-url("../../../../assets/lucide/arrow-big-right.svg"); colorize: root.stepper ? Theme.text-tertiary : Theme.accent; }
        }
    }
}

// The settings menu. Tiered: a root list of sections, and a panel per section.
// Held open by the menu key on the home screen; owns the D-pad while it is up.
//
// It carries its own FocusScope rather than being driven by the shell, the way
// the keyboard does: a modal with its own navigation is simpler to reason about
// than one whose every key has to be forwarded, and returning focus to the
// shell on close is a single `.focus()`.
//
// The shell holds the values (brightness, the timeout choices, the Wi-Fi and
// SSH state) and the host applies and persists them; this only shows them and
// emits what changed. Left and right step a value where a row has one; OK
// enters a section or fires an action; BACK climbs one tier, and closes from
// the root.
export component Settings inherits Rectangle {
    in property <bool> shown: false;

    // Display.
    in-out property <int> brightness;          // 10..100, in tens
    in-out property <bool> keys-on;            // keypad backlight while awake
    in property <[string]> dim-choices;
    in-out property <int> dim-index;
    in property <[string]> off-choices;
    in-out property <int> off-index;
    // Wi-Fi.
    in property <string> wifi-ssid;            // "" when not connected
    in property <int> wifi-level;
    in property <string> wifi-signal;
    // SSH.
    in property <bool> ssh-on;
    in property <bool> ssh-available;          // a key or password is enrolled
    in property <bool> ssh-busy;               // switching, on a thread
    in property <string> bt-state;             // off, starting, on, error
    in property <bool> bt-available;           // the kernel has Bluetooth at all
    in property <string> bt-peer;              // the TV connected now, "" if none
    // Updates. The host mirrors the system service's status here.
    in property <string> update-installed;
    in property <string> update-boot;          // installed boot image, "" if none
    in property <string> update-channel;       // "Stable" / "Alpha"
    in property <string> update-summary;       // the value on the check row
    in property <bool> update-can-install;
    in property <bool> update-busy;            // a check, download or restart is in flight
    in property <bool> update-ready;
    in property <bool> update-armed;           // one OK given, waiting for the second
    in property <string> update-message;
    // Network: read by the host from the kernel's tables while the panel is up.
    in property <string> net-address;          // "192.168.1.127 /24"
    in property <string> net-gateway;
    in property <string> net-dns;
    in property <string> net-mac;
    in property <string> net-web;              // "http://couch.local  ·  192.168.1.127:8090"
    // Power: three actions; recovery takes two presses.
    in property <bool> power-busy;
    in property <bool> power-armed;
    in property <string> power-message;

    callback brightness-changed(int);
    callback keys-changed(bool);
    callback dim-changed(int);
    callback off-changed(int);
    callback change-wifi();
    callback recovery-wifi();
    callback toggle-ssh();
    callback toggle-bluetooth();
    callback pair-bluetooth();                 // open pairing mode (panel 7, row 1)
    callback update-check();
    callback update-install();
    callback update-restart();
    callback update-channel-step(int);
    callback power-action(int);                // 0 off, 1 restart, 2 recovery
    // Enter panel N, or leave the current tier - the host performs these as
    // slides (like the hub's page changes), so it owns the panel and this only
    // asks. leave() climbs to the root, or closes settings from the root.
    callback enter(int);
    callback leave();

    public function take-focus() { fs.focus(); }

    // 0 root, 1 display, 2 wifi, 3 ssh, 4 updates, 5 network, 6 power,
    // 7 bluetooth. Set by
    // the host so the change can be slid to; the cursor resets whenever it
    // moves. Panel numbers are stable ids; the root list has its own order.
    in property <int> panel: 0;
    property <int> sel: 0;
    changed panel => { root.sel = 0; }
    // The Updates step row comes and goes with the service's state; the cursor
    // must never be left on a row that is no longer there.
    changed update-can-install => { root.sel = Math.min(root.sel, root.row-count() - 1); }
    changed update-busy => { root.sel = Math.min(root.sel, root.row-count() - 1); }
    changed update-ready => { root.sel = Math.min(root.sel, root.row-count() - 1); }
    // The Pair row is only there while Bluetooth is on.
    changed bt-state => { root.sel = Math.min(root.sel, root.row-count() - 1); }
    property <length> row-h: 72px;
    property <length> gap: 10px;
    property <length> pitch: root.row-h + root.gap;
    property <[string]> sections: ["Display", "Wi-Fi", "Bluetooth", "Network", "SSH", "Updates", "Power"];
    property <[int]> section-panels: [1, 2, 7, 5, 3, 4, 6];

    // Rows per panel, for wrapping the cursor.
    function row-count() -> int {
        if (root.panel == 0) { return root.sections.length; }
        if (root.panel == 1) { return 4; }   // brightness, keys, dim, off
        if (root.panel == 2) { return 2; }   // change network
        if (root.panel == 4) {               // installed, channel, check, then the step row
            return 3 + (root.update-can-install || root.update-busy || root.update-ready ? 1 : 0);
        }
        if (root.panel == 5) { return 5; }   // address, gateway, dns, mac, web
        if (root.panel == 6) { return 3; }   // off, restart, recovery
        if (root.panel == 7) {               // toggle, then Pair with TV once on
            return root.bt-state == "on" ? 2 : 1;
        }
        return 1;                            // ssh toggle
    }

    // True where left/right change a value rather than doing nothing.
    function row-has-stepper() -> bool {
        return root.panel == 1 || (root.panel == 4 && root.sel == 1);
    }

    function step(delta: int) {
        if (root.panel == 4) {
            if (root.sel == 1) { root.update-channel-step(delta); }
            return;
        }
        if (root.panel != 1) { return; }
        if (root.sel == 0) {
            root.brightness = Math.max(10, Math.min(100, root.brightness + delta * 10));
            root.brightness-changed(root.brightness);
        } else if (root.sel == 1) {
            root.keys-on = !root.keys-on;
            root.keys-changed(root.keys-on);
        } else if (root.sel == 2) {
            root.dim-index = Math.mod(root.dim-index + delta + root.dim-choices.length,
                                      root.dim-choices.length);
            root.dim-changed(root.dim-index);
        } else {
            root.off-index = Math.mod(root.off-index + delta + root.off-choices.length,
                                      root.off-choices.length);
            root.off-changed(root.off-index);
        }
    }

    function activate() {
        if (root.panel == 0) { root.enter(root.section-panels[root.sel]); return; }
        if (root.panel == 6) { if (!root.power-busy) { root.power-action(root.sel); } return; }
        if (root.panel == 2) {
            if (root.sel == 0) { root.change-wifi(); } else { root.recovery-wifi(); }
            return;
        }
        if (root.panel == 3) { root.toggle-ssh(); return; }
        if (root.panel == 7) {
            if (root.sel == 0) { root.toggle-bluetooth(); } else { root.pair-bluetooth(); }
            return;
        }
        if (root.panel == 4) {
            if (root.sel == 2) { root.update-check(); }
            else if (root.sel == 3) {
                if (root.update-ready) { root.update-restart(); }
                else if (root.update-can-install && !root.update-busy) { root.update-install(); }
            }
            return;
        }
        // Display rows have no OK action; left/right do the work.
    }

    // Climb one tier, or close from the root: the host decides which and slides.
    function back() { root.leave(); }

    fs := FocusScope {
        enabled: root.shown;
        key-pressed(e) => {
            if (e.text == Key.UpArrow) {
                root.sel = Math.mod(root.sel - 1 + root.row-count(), root.row-count());
                return accept;
            }
            if (e.text == Key.DownArrow) {
                root.sel = Math.mod(root.sel + 1, root.row-count());
                return accept;
            }
            if (e.text == Key.LeftArrow)  { root.step(-1); return accept; }
            if (e.text == Key.RightArrow) { root.step(1);  return accept; }
            if (e.text == Key.Return) { root.activate(); return accept; }
            if (e.text == Key.Escape) { root.back(); return accept; }
            return accept;   // modal: swallow everything while up
        }
    }

    background: Theme.bg;

    VerticalLayout {
        padding-left: Theme.pad-side;
        padding-right: Theme.pad-side;
        padding-top: Theme.pad-top;
        padding-bottom: Theme.pad-bottom;
        spacing: 14px;

        // Header: the section name, or SETTINGS at the root.
        Text {
            text: root.panel == 0 ? "SETTINGS"
                : root.panel == 1 ? "DISPLAY"
                : root.panel == 2 ? "WI-FI"
                : root.panel == 3 ? "SSH"
                : root.panel == 7 ? "BLUETOOTH"
                : root.panel == 5 ? "NETWORK"
                : root.panel == 6 ? "POWER" : "UPDATES";
            font-size: 15px;
            letter-spacing: 0.14 * 15px;
            color: Theme.text-quaternary;
        }

        // The rows for the current panel, and one moving ring over them.
        Rectangle {
            // Root: the section list.
            if root.panel == 0: VerticalLayout {
                spacing: root.gap;
                for name[i] in root.sections: Rectangle {
                    height: root.row-h;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.r-card;
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px;
                        Text {
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            text: name;
                            font-size: 21px;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        VerticalLayout {
                            alignment: center;
                            Image { width: 26px; height: 26px; source: @image-url("../../../../assets/lucide/arrow-big-right.svg"); colorize: Theme.text-tertiary; }
                        }
                    }
                }
            }

            // Display: four stepper rows.
            if root.panel == 1: VerticalLayout {
                spacing: root.gap;
                SettingsRow { title: "Brightness"; value: root.brightness + "%"; }
                SettingsRow { title: "Key backlight"; value: root.keys-on ? "On" : "Off"; }
                SettingsRow { title: "Dim after"; value: root.dim-choices[root.dim-index]; }
                SettingsRow { title: "Screen off after"; value: root.off-choices[root.off-index]; }
            }

            // Wi-Fi: status and a change action.
            if root.panel == 2: VerticalLayout {
                spacing: root.gap;
                SettingsRow {
                    title: root.wifi-ssid == "" ? (root.wifi-level > 0 ? "Connected" : "Not connected") : root.wifi-ssid;
                    value: root.wifi-level == 0 ? "" : root.wifi-signal;
                    stepper: false;
                }
                SettingsRow { title: "Change network"; arrow: true; stepper: false; }
                SettingsRow { title: "Recovery hotspot"; arrow: true; stepper: false; }
            }

            // SSH: a single toggle.
            if root.panel == 3: VerticalLayout {
                spacing: root.gap;
                SettingsRow {
                    title: "SSH access";
                    value: !root.ssh-available ? "unset"
                        : root.ssh-busy ? (root.ssh-on ? "STARTING…" : "STOPPING…")
                        : root.ssh-on ? "ON" : "OFF";
                    stepper: false;
                }
            }

            // Bluetooth: the toggle, naming the TV on the link once there is
            // one, and pairing mode below it while the stack is up. The stack
            // takes a few seconds to come up, and the row says so while it does.
            if root.panel == 7: VerticalLayout {
                spacing: root.gap;
                SettingsRow {
                    title: "Bluetooth";
                    value: !root.bt-available ? "no kernel support"
                        : root.bt-state == "on" ? (root.bt-peer == "" ? "ON" : "ON · " + root.bt-peer)
                        : root.bt-state == "starting" ? "STARTING…"
                        : root.bt-state == "error" ? "FAILED"
                        : "OFF";
                    stepper: false;
                }
                if root.bt-state == "on": SettingsRow { title: "Pair with TV"; arrow: true; stepper: false; }
            }

            // Updates: what is installed, the channel, a check, and then the
            // step that applies (download, or the two-press restart), with the
            // service's own message underneath.
            if root.panel == 4: VerticalLayout {
                spacing: root.gap;
                SettingsRow { title: "Installed"; value: root.update-installed; stepper: false; }
                SettingsRow { title: "Channel"; value: root.update-channel; }
                SettingsRow { title: "Check for updates"; value: root.update-summary; stepper: false; }
                // One step row: what to do next, or what is happening now. It
                // stays put while a download runs so the cursor has somewhere
                // to be until "Install & restart" takes its place.
                if root.update-can-install || root.update-busy || root.update-ready: SettingsRow {
                    title: root.update-ready ? "Install & restart" : root.update-busy ? "Working…" : "Download & verify";
                    value: root.update-ready ? (root.update-armed ? "OK again" : "") : root.update-busy ? root.update-summary : "";
                    arrow: !root.update-busy && !(root.update-ready && root.update-armed);
                    stepper: false;
                }
                // Which kernel and boot ramdisk the partition carries, written
                // by a separate boot payload. Read-only, and last, so the
                // cursor's fixed row indices above are undisturbed.
                if root.update-boot != "": SettingsRow { title: "Boot image"; value: root.update-boot; stepper: false; }
                Text {
                    text: root.update-message;
                    font-size: 15px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    height: 96px;
                    vertical-alignment: top;
                }
            }

            // Network: what the kernel says, read-only.
            if root.panel == 5: VerticalLayout {
                spacing: root.gap;
                SettingsRow { title: "Address"; value: root.net-address == "" ? "none" : root.net-address; stepper: false; }
                SettingsRow { title: "Gateway"; value: root.net-gateway == "" ? "none" : root.net-gateway; stepper: false; }
                SettingsRow { title: "DNS"; value: root.net-dns == "" ? "none" : root.net-dns; stepper: false; }
                SettingsRow { title: "Wi-Fi MAC"; value: root.net-mac; stepper: false; }
                SettingsRow { title: "Web UI"; value: root.net-web; stepper: false; }
            }

            // Power: three actions, and the service's answer underneath.
            if root.panel == 6: VerticalLayout {
                spacing: root.gap;
                SettingsRow { title: "Power off"; arrow: true; stepper: false; }
                SettingsRow { title: "Restart"; arrow: true; stepper: false; }
                SettingsRow { title: "Restart into recovery"; value: root.power-armed ? "OK again" : ""; arrow: !root.power-armed; stepper: false; }
                Text {
                    text: root.power-message;
                    font-size: 15px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    height: 120px;
                    vertical-alignment: top;
                }
            }

            // The focus ring. Its row differs between panels: on Wi-Fi the
            // cursor sits on the "Change network" row (index 1 of two), so the
            // ring is offset by one there.
            Rectangle {
                x: 0px;
                y: (root.panel == 2 ? root.sel + 1 : root.sel) * root.pitch;
                width: parent.width;
                height: root.row-h;
                background: transparent;
                animate y { duration: 140ms; easing: ease-out; }
                FocusRing {
                    focused: true;
                    radius-inner: Theme.r-card;
                    box-width: parent.width;
                    box-height: parent.height;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        // A footer hint, so the controls are discoverable without a manual.
        Text {
            text: root.panel == 1 ? "Left / right to change  ·  Back to return"
                : root.panel == 0 ? "OK to open  ·  Back to close"
                : root.panel == 4 ? "OK to run  ·  Left / right for channel  ·  Back to return"
                : root.panel == 5 ? "Back to return"
                : root.panel == 6 ? "OK to run  ·  Back to return"
                : "OK to change  ·  Back to return";
            font-size: 14px;
            color: Theme.text-quaternary;
            horizontal-alignment: center;
        }
    }

    // Focus on creation: shown conditionally, so this runs when it appears.
    init => { fs.focus(); }
}
