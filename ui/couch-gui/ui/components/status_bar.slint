import { Theme } from "../theme.slint";

// Fixed, present on every screen. The centre title is the only thing that
// changes between screens, so it is a single property on the shell.
//
// It carries the area name rather than a constant "HOME": a static word on the
// one line always on screen was spending the most valuable strip in the UI on
// nothing, and the name has to be somewhere. The hub below keeps only the page
// dots, which buys the room list most of a row.
export component StatusBar inherits Rectangle {
    in property <string> clock;
    in property <string> title;
    in property <int> battery;      // 0-100 where known
    in property <bool> battery-known: false;
    in property <bool> charging: false;
    in property <bool> show-battery-percentage: false;
    in property <int> wifi-level;   // 0 disconnected, 1-4 signal bars

    height: 56px;
    background: Theme.bg;

    // 1px bottom rule
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-dim;
    }

    Text {
        x: Theme.pad-side;
        y: (parent.height - self.height) / 2;
        text: root.clock;
        font-size: 19px;
        color: Theme.text;
    }

    Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.title;
        // Keep long room names clear of the status indicators.
        width: max(0px, 2 * (wifi.x - 12px) - parent.width);
        horizontal-alignment: center;
        overflow: elide;
        // Match the section labels and keyboard at 15px, with letter spacing
        // to keep the area title distinct from the clock.
        font-size: 15px;
        letter-spacing: 0.12 * 15px;
        color: Theme.accent;
    }


    // The bolt follows the kernel's reported charging state, not cable
    // presence. The generic outline represents an unavailable percentage.
    battery-icon := Image {
        width: 24px;
        height: 24px;
        x: parent.width - self.width - Theme.pad-side;
        y: (parent.height - self.height) / 2;
        source: !root.battery-known ? @image-url("../../../../assets/lucide/battery.svg")
              : root.charging ? @image-url("../../../../assets/lucide/battery-charging.svg")
              : root.battery < 20 ? @image-url("../../../../assets/lucide/battery-low.svg")
              : root.battery < 60 ? @image-url("../../../../assets/lucide/battery-medium.svg")
              : @image-url("../../../../assets/lucide/battery-full.svg");
        colorize: Theme.text-secondary;
    }

    battery-percent := Text {
        visible: root.battery-known && root.show-battery-percentage;
        text: root.battery + "%";
        font-size: 15px;
        color: Theme.text-secondary;
        x: battery-icon.x - self.width - 8px;
        y: (parent.height - self.height) / 2;
    }

    // Four signal bars, a right-climbing staircase, bottom-aligned. Lit up to
    // wifi-level in the secondary ink, the rest recessed; at level 0 - the
    // radio down - all four are recessed, which reads as "no signal" without a
    // second colour. Drawn from rectangles rather than a glyph: four filled
    // rects are cheaper than an anti-aliased icon and the design has no wifi
    // glyph embedded.
    wifi := Rectangle {
        width: 18px;
        height: 14px;
        x: (root.battery-known && root.show-battery-percentage ? battery-percent.x : battery-icon.x) - self.width - 10px;
        y: (parent.height - self.height) / 2;
        for bar[i] in [5px, 8px, 11px, 14px]: Rectangle {
            width: 3px;
            height: bar;
            x: i * 5px;
            y: parent.height - self.height;
            border-radius: 1px;
            background: i + 1 <= root.wifi-level ? Theme.text-secondary : Theme.border-raised;
        }
    }
}
