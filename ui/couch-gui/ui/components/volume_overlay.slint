import { Theme } from "../theme.slint";

// Shared feedback card. Slides without taking focus or moving the underlying page.
export component VolumeOverlay inherits Rectangle {
    in property <string> target;
    in property <string> caption: "Volume";
    in property <int> value;
    in property <string> value-text;
    in property <bool> shown;
    in property <bool> percentage: false;
    in property <bool> meter: true;
    // Optional artwork (a track's cover) beside the text.
    in property <image> art;
    in property <bool> has-art: false;
    height: 140px;
    background: transparent;
    property <float> reveal: root.shown ? 1 : 0;
    animate reveal { duration: 200ms; easing: ease-out; }

    Rectangle {
        x: 0px;
        y: (1 - root.reveal) * (root.height + 40px);
        width: root.width; height: root.height;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-raised;
        border-radius: Theme.r-overlay;
        if root.has-art: Image {
            x: parent.width - 18px - 84px; y: 18px; width: 84px; height: 84px;
            source: root.art; image-fit: cover;
        }
        VerticalLayout {
            padding: 18px;
            padding-right: root.has-art ? 18px + 84px + 14px : 18px;
            spacing: 9px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.caption;
                    horizontal-stretch: 1;
                    overflow: elide;
                    font-size: 22px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                if root.meter || root.value-text != "": Text {
                    text: root.value-text != "" ? root.value-text : root.percentage ? root.value + "%" : root.value;
                    horizontal-stretch: 0;
                    font-size: 30px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: right;
                }
            }
            Text {
                text: root.target;
                font-size: 26px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.meter: Rectangle {
                height: 10px;
                border-radius: Theme.r-meter;
                background: Theme.border-raised;
                Rectangle {
                    x: 0px;
                    width: parent.width * max(0, min(100, root.value)) / 100;
                    height: parent.height;
                    border-radius: Theme.r-meter;
                    background: Theme.accent;
                }
            }
        }
    }
}
