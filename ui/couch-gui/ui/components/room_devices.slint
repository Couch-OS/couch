import { Theme } from "../theme.slint";
import { FocusRing } from "focus_ring.slint";
import { DeviceDisc } from "device_disc.slint";
import { ChoiceItem } from "chooser.slint";

// One flat list. State updates mutate model rows, preserving focus and scroll.
export component RoomDevices inherits Rectangle {
    in property <bool> shown;
    in property <string> detail;
    in property <[ChoiceItem]> items;
    in-out property <int> index: 0;
    property <bool> ok-down: false;
    property <length> scroll: 0px;
    callback activate(int);
    callback brightness(int, int);
    // A speaker row's physical keys: volume-up/down, mute, next, previous.
    callback media(int, string);
    callback back();
    callback open-scenes();
    callback scene-step(int);
    in property <int> scene-count;
    in property <string> scene-label;
    // Reserve the footer and focus outline, then fill the window with whole cards.
    property <length> rows-h: root.height - Theme.pad-top - (root.detail == "" ? 150px : 190px) - 12px;
    property <length> row-gap: 12px;
    property <int> visible-rows: max(1, floor((root.rows-h + root.row-gap) / (90px + root.row-gap)));
    property <length> row-h: (root.rows-h - (root.visible-rows - 1) * root.row-gap) / root.visible-rows;
    property <length> pitch: root.row-h + root.row-gap;
    property <length> scroll-goal: 0px;
    property <length> max-scroll: max(0px, root.items.length * root.pitch - root.row-gap - root.rows-h);
    // The scenes card, read once by the layout below and once by the ring
    // arithmetic, so the two cannot disagree.
    property <length> scenes-card-h: 74px;
    property <length> scenes-y: root.height - 96px;
    property <bool> anim: false;
    animate scroll { duration: root.anim ? 160ms : 0ms; easing: ease-out; }
    changed items => {
        root.index = 0;
        root.anim = false;
        root.scroll-goal = 0px;
        root.scroll = 0px;
        root.place-ring();
    }
    changed shown => { root.ok-down = false; }
    changed index => { root.follow-focus(true); }
    changed rows-h => {
        root.anim = false;
        root.scroll-goal = 0px;
        root.scroll = 0px;
        root.follow-focus(false);
    }
    function follow-focus(animate-ring: bool) {
        root.anim = animate-ring;
        if (root.index < root.items.length) {
            root.row-into-view(root.index * root.pitch);
        }
        root.place-ring();
    }
    // Minimal scrolling: move only far enough to bring the focused row fully
    // into the window, and not at all while it is already there. The scenes
    // card is furniture under the window rather than a row in it, so a wrap
    // onto it leaves the rows where they are and only the ring travels - the
    // areas list wraps onto its own scenes row the same way.
    function row-into-view(row-y: length) {
        if (row-y < root.scroll-goal) {
            root.scroll-goal = row-y;
        } else if (row-y + root.row-h > root.scroll-goal + root.rows-h) {
            root.scroll-goal = min(root.max-scroll, row-y + root.row-h - root.rows-h);
        } else {
            return;
        }
        root.scroll = root.scroll-goal;
    }
    // Where the ring goes, in page space, set here and only here. Taken off
    // the scroll's destination rather than its animating value, so the two
    // share one curve instead of chasing each other: the ring used to live in
    // the scrolling content and stopped being set at all once focus left the
    // rows, which is what sent it back to the top on the way out of scenes.
    function place-ring() {
        if (root.index >= root.items.length) {
            fs.ring-y = root.scenes-y;
            fs.ring-h = root.scenes-card-h;
            fs.ring-r = Theme.r-card;
        } else {
            // 6px is the outline's bleed, which the window and its content are
            // both inset by; arithmetic, not read back off the laid-out boxes.
            fs.ring-y = Theme.pad-top + 6px + root.index * root.pitch - root.scroll-goal;
            fs.ring-h = root.row-h;
            fs.ring-r = root.items[root.index].activity ? Theme.r-card : Theme.r-row;
        }
    }
    public function take-focus() { keys.focus(); }
    /// The window's destination and where the ring is now, for the room
    /// navigation test. Functions rather than out properties: a binding on
    /// either would make a reader of the ring's geometry, and every frame of
    /// a move would repaint whatever read it (docs/slint-notes.md).
    public function scroll-destination() -> length { return root.scroll-goal; }
    public function ring-position() -> length { return fs.ring-y; }
    /// The rest of the highlighted row's box, for the iris that opens out of
    /// it (panel.rs). Read at the press rather than kept anywhere, for the
    /// same reason as the two above; the x and the width are the arithmetic
    /// the list above is laid out by, not a reading of it.
    public function ring-height() -> length { return fs.ring-h; }
    public function ring-radius() -> length { return fs.ring-r; }
    public function ring-box-x() -> length { return Theme.pad-side; }
    public function ring-box-width() -> length { return root.width - 2 * Theme.pad-side; }
    /// One row to the next, so the lift can find the bands either side of the
    /// focused one without being told the whole list.
    public function row-pitch() -> length { return root.pitch; }
    /// Where a row's name is drawn inside its card - the rectangle the lift
    /// cuts out and flies to the control screen's title. Arithmetic that
    /// mirrors the layout above rather than a reading of it, for the reason
    /// `place-ring` is: reading a laid-out box back dirties the subtree that
    /// holds it. The band is generous on purpose; the pixels that are the
    /// card rather than the name are dropped when it is put down.
    public function disc-inset() -> length { return 18px; }
    /// Where the disc sits down the row: the layout above pads the card by
    /// `disc-inset` all round and centres the disc in what is left, so this
    /// is that arithmetic and not a guess at it - the lift flies this very
    /// rectangle to the screen's own disc, and a pixel out shows.
    public function disc-box-y() -> length { return 18px; }
    public function label-box-x() -> length { return 18px + 52px + 16px; }
    public function label-box-w() -> length {
        return root.width - 2 * Theme.pad-side - (18px + 52px + 16px) - 16px - 22px - 18px;
    }
    public function label-box-h() -> length { return 34px; }
    public function label-box-y() -> length { return (root.row-h - 58px) / 2; }
    // One ring for the whole page rather than one per section, and its
    // geometry on a zero-size element so that moving it cannot dirty the root
    // that paints the background. Set imperatively, because a bound property
    // reads its `animate` duration a frame late - both reasons are the area
    // pane's, in docs/slint-notes.md.
    fs := Rectangle {
        width: 0px;
        height: 0px;
        property <length> ring-y: Theme.pad-top + 6px;
        property <length> ring-h: 90px;
        property <length> ring-r: Theme.r-row;
        // The scrolling curve, so the outline stays on its moving row.
        animate ring-y, ring-h { duration: root.anim ? 160ms : 0ms; easing: ease-out; }
    }
    background: Theme.bg;
    list := Rectangle {
        x: Theme.pad-side - 6px; y: Theme.pad-top;
        width: parent.width - 2 * (Theme.pad-side - 6px);
        height: root.rows-h + 12px; clip: true;
        Rectangle {
            x: 6px; y: 6px - root.scroll; width: parent.width - 12px;
            height: max(0px, root.items.length * root.pitch - root.row-gap);
            for item[i] in root.items : Rectangle {
                x: 0px; y: i * root.pitch; width: parent.width; height: root.row-h;
                // An activity row is the area page's activity strip, at row
                // height: raised card, accent glyph, title over "source · room".
                background: item.activity ? Theme.surface-raised : Theme.surface;
                border-width: 1px;
                border-color: item.activity ? Theme.border-raised : Theme.border;
                border-radius: item.activity ? Theme.r-card : Theme.r-row;
                // Like the room list, a tap selects; OK acts on the focused row.
                TouchArea { clicked => { root.index = i; } }
                if item.activity: HorizontalLayout {
                    padding-left: 18px; padding-right: 18px; spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        if item.kind == 0: HorizontalLayout {
                            spacing: 3px;
                            alignment: center;
                            Rectangle { width: 3px; height: 10px; background: Theme.accent; }
                            Rectangle { width: 3px; height: 16px; background: Theme.accent; }
                            Rectangle { width: 3px; height: 7px; background: Theme.accent; }
                        }
                        if item.kind != 0: Image {
                            source: @image-url("../../assets/glyph-play.png");
                            width: 14px; height: 18px;
                            colorize: Theme.accent;
                        }
                    }
                    VerticalLayout {
                        alignment: center; spacing: 2px; horizontal-stretch: 1;
                        Text { text: item.title; color: Theme.text; font-size: 21px; font-weight: 600; overflow: elide; }
                        Text { text: item.detail; color: Theme.text-secondary; font-size: 14px; letter-spacing: 0.06 * 14px; overflow: elide; }
                    }
                }
                if !item.activity: HorizontalLayout {
                    padding: 18px; spacing: 16px;
                    DeviceDisc { icon: item.icon; active: item.active; known: item.power-known; }
                    VerticalLayout {
                        alignment: center; spacing: 2px; horizontal-stretch: 1;
                        Text { text: item.title; color: Theme.text; font-size: Theme.device-name; font-weight: Theme.device-name-weight; overflow: elide; }
                        Text { text: item.detail; color: item.active ? Theme.accent : Theme.text-secondary; font-size: 19px; overflow: elide; }
                    }
                    // A row whose OK opens a screen says so with a chevron
                    // rather than words: the state text is what matters, and
                    // there is no room for both.
                    Rectangle {
                        width: 22px; horizontal-stretch: 0; background: transparent;
                        Image {
                            x: 0px; y: (parent.height - 22px) / 2; width: 22px; height: 22px;
                            source: @image-url("../../../../assets/lucide/chevron-right.svg");
                            colorize: Theme.text-quaternary;
                            visible: item.controls;
                        }
                    }
                }
            }
        }
    }
    Text { x: 20px; y: parent.height - 188px; width: parent.width - 40px; height: 48px; text: root.detail; color: Theme.text-secondary; font-size: 16px; wrap: word-wrap; }
    Text { x: Theme.pad-side; y: parent.height - 128px; text: "SCENES"; color: Theme.text-secondary; font-size: 15px; letter-spacing: 1.8px; }
    Rectangle {
        x: Theme.pad-side; y: root.scenes-y; width: parent.width - 2 * Theme.pad-side; height: root.scenes-card-h;
        background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.r-card;
        Text { x: 18px; y: 0px; width: parent.width - 70px; height: parent.height; vertical-alignment: center; text: root.scene-label; overflow: elide; color: Theme.text; font-size: 21px; }
        Image { x: parent.width - 40px; y: 26px; width: 22px; height: 22px; source: @image-url("../../../../assets/lucide/arrow-big-right.svg"); colorize: Theme.text-secondary; }
        TouchArea { clicked => { root.index=root.items.length; root.open-scenes(); } }
    }
    // Drawn last so it is never behind a card, and outside the clipped window
    // so a scroll and a focus move do not have to be reconciled - ring-y is in
    // page space with the scroll already taken off.
    Rectangle {
        x: Theme.pad-side; y: fs.ring-y; width: parent.width - 2 * Theme.pad-side; height: fs.ring-h;
        background: transparent;
        FocusRing { focused: true; radius-inner: fs.ring-r; box-width: parent.width; box-height: parent.height; }
    }
    keys := FocusScope {
        enabled: root.shown;
        key-pressed(e) => {
            // Channel keys step scenes, unless a speaker is highlighted: then
            // they skip tracks, and the volume and mute keys drive it too.
            if (e.text == Key.F21 || e.text == Key.F22) {
                if (root.index < root.items.length && root.items[root.index].media) {
                    root.media(root.index, e.text == Key.F21 ? "next" : "previous");
                } else {
                    root.scene-step(e.text == Key.F21 ? 1 : -1);
                }
                return accept;
            }
            if (e.text == Key.F23 || e.text == Key.F24) {
                if (root.index < root.items.length && root.items[root.index].light) {
                    root.brightness(root.index, e.text == Key.F23 ? 5 : -5);
                } else if (root.index < root.items.length && root.items[root.index].media) {
                    root.media(root.index, e.text == Key.F23 ? "volume-up" : "volume-down");
                }
                return accept;
            }
            if (e.text == Key.F14) {
                if (root.index < root.items.length && root.items[root.index].media) {
                    root.media(root.index, "mute");
                }
                return accept;
            }
            if (e.text == Key.Escape) { root.back(); return accept; }
            if (e.text == Key.UpArrow) { root.index = Math.mod(root.index - 1 + root.items.length + 1, root.items.length + 1); return accept; }
            if (e.text == Key.DownArrow) { root.index = Math.mod(root.index + 1, root.items.length + 1); return accept; }
            if (e.text == Key.Return) { if (!root.ok-down) { root.ok-down = true; if (root.index == root.items.length) { root.open-scenes(); } else { root.activate(root.index); } } return accept; }
            return accept;
        }
        key-released(e) => { if (e.text == Key.Return) { root.ok-down = false; } return accept; }
    }
}
