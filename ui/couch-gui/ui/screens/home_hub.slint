import { Theme } from "../theme.slint";
import { FocusRing } from "../components/focus_ring.slint";
import { SectionLabel } from "../components/section_label.slint";
import { DeviceDisc } from "../components/device_disc.slint";

export struct LiveActivity {
    kind: int,          // 0 sonos (bars), 1 kodi (play triangle)
    title: string,
    // Subtitle halves, joined with a literal separator below: glyphs are
    // embedded at compile time from strings that appear in .slint, so a
    // separator living only in a runtime string is never embedded.
    source: string,     // SONOS
    place: string,      // KITCHEN
}

export struct RoomRow {
    name: string,
    devices: string,    // "5 devices"
    detail: string,     // "Kodi, Hue, LG C3" - may be empty

    icon: image,
    power-state: int,   // -1 unknown, 0 all off, 1 any on
    active-count: int,
    status-known: bool,
    idle: bool,
    offline: bool,
    dimmed: bool,       // On, but every light reporting a level is under half
    // A Lucide icon, see RoomIcon: 0 sofa, 1 bed, 2 cooking pot, 3 open book,
    // 4 open door, 5 car, 6 trees, 7 lamp, 8 tv, anything else a house.
    glyph: int,
}

export struct SceneCell {
    name: string,
    active: bool,
}

// Room icons use the pre-rasterized Lucide catalog and theme tinting.
component AreaPane inherits Rectangle {
    in property <[LiveActivity]> activities;
    in property <[RoomRow]> rooms;
    in property <[SceneCell]> scenes;

    // Stops are one linear ring in reading order: row 0 is the activity strip
    // when there is one, the rooms follow, and the scenes row is last. That
    // arithmetic lives here and nowhere else. The shell reads it back to wrap
    // around; the host is told what was opened, never which row.
    //
    // Not handled: activities appearing or vanishing under focus, which would
    // shift every row index while focus-row stayed where it was. Deferred
    // until a daemon exists that can make it happen.
    in property <int> focus-row;
    out property <int> first-room-row: root.activities.length > 0 ? 1 : 0;
    out property <int> scenes-row: root.first-room-row + root.rooms.length;
    out property <int> row-count: root.scenes-row + 1;

    // A tap names a stop; it does not act on it. Touch and the D-pad then
    // agree on one selection, and the ring is always the truth about what OK
    // will do - which it would not be if a finger could act somewhere the ring
    // is not. The keyboard, where a key has no meaningful selected state, is
    // where direct activation belongs instead. The strip and the scenes row
    // exist only to be opened, so a tap on those also opens.
    callback pick(int);
    callback open-strip();
    callback open-room(int);        // an index into rooms
    callback open-scenes();

    /// OK: open whatever the ring is on.
    public function activate() {
        if (root.focus-row < root.first-room-row) {
            root.open-strip();
        } else if (root.focus-row >= root.scenes-row) {
            root.open-scenes();
        } else {
            root.open-room(root.focus-row - root.first-room-row);
        }
    }

    // Gone while the host composes a page transition, so the frame it renders
    // of the new page has no ring on it; back, with a fade, once the page has
    // arrived. Instant one way and slow the other, see the ring below.
    in property <bool> ring-hidden: false;

    // The area list scrolls rather than paginating. Everything else on the hub
    // stays put, so the strip, the labels and the scenes never move - only the
    // rows travel under a fixed window.
    property <length> row-h: (root.rows-h - (root.visible-rows - 1) * root.row-gap) / root.visible-rows;
    property <length> row-gap: 12px;
    property <length> row-pitch: root.row-h + root.row-gap;
    property <length> ring-bleed: 6px;       // ring offset + width
    property <length> gap: 14px;             // between the stacked blocks

    // Furniture heights, each read once by the layout and once by the
    // arithmetic under it, so the two cannot disagree.
    property <length> strip-h: 66px;
    property <length> scenes-card-h: 74px;
    property <length> label-h: 19px;
    /// A slot between the rooms and the scenes label, left empty here and drawn
    /// into by the shell. The pager belongs to the hub, not to a page - it must
    /// not slide with one - but it belongs *here* on the screen, so the pane
    /// reserves the space and publishes where it ended up.
    out property <length> dots-h: 6px;

    // Everything under the rooms is anchored to the bottom: its place is the
    // pane's height less fixed furniture, the same with or without a strip,
    // and the rooms window is whatever is left between. Computed from the
    // pane's own height, NOT read back off the laid-out boxes.
    //
    // Reading roomsbox.height here was a cycle: the box's child is sized from
    // rows-h, and rows-h came from the box. Slint resolves it, but it meant any
    // invalidation inside that subtree re-ran the pane's layout, and a layout
    // re-run dirties the whole component - a 452x654 rect, ~23ms, on the first
    // frame of every focus move. The animation after it was always smooth; the
    // stutter was this frame, at the front of it.
    property <length> rooms-y: root.activities.length > 0
        ? root.strip-h + 2 * root.ring-bleed + root.gap : 0px;
    property <length> scenes-y: root.height - root.scenes-card-h - 2 * root.ring-bleed;
    out property <length> dots-y: root.scenes-y - root.gap - root.label-h - root.gap - root.dots-h;
    // Fit whole rows into the available window. Keep at least the original
    // 90px card height; the gap also clears both sides of the focus outline.
    property <length> rows-h: root.dots-y - root.gap - 2 * root.ring-bleed - root.rooms-y;

    property <int> visible-rows: max(1, floor((root.rows-h + root.row-gap) / (90px + root.row-gap)));

    in-out property <length> scroll: 0px;
    // The window and focus ring share the same row-aligned destination.
    property <length> scroll-goal: 0px;
    property <length> max-scroll: max(0px,
        root.rooms.length * root.row-pitch - root.row-gap - root.rows-h);

    // Read at the moment the ring is set - see place-ring() for why
    // that matters - true for a focus move, false for a landing.
    property <bool> anim: true;
    // Animate between row-aligned destinations, matching the focus ring.
    animate scroll { duration: root.anim ? 160ms : 0ms; easing: ease-out; }

    /// Focus moved, by D-pad or tap: bring the row into the window if it is
    /// not already there, and glide the ring onto it.
    public function follow-focus() {
        root.anim = true;
        if (root.focus-row >= root.first-room-row && root.focus-row < root.scenes-row) {
            root.row-into-view((root.focus-row - root.first-room-row) * root.row-pitch);
        }
        root.place-ring();
    }
    /// The page underneath changed: the old scroll position means nothing on
    /// a new list, so it starts at the top, and the ring lands on the new page
    /// rather than travelling to it. Nothing moved; the page did.
    public function land() {
        root.anim = false;
        root.scroll-goal = 0px;
        root.scroll = 0px;
        root.place-ring();
    }

    // Minimal scrolling: move only far enough to bring the focused row fully
    // into the window, and not at all while it is already there. Recomputing
    // from the index alone would scroll on moves that did not need it.
    function row-into-view(row-y: length) {
        if (row-y < root.scroll-goal) {
            root.scroll-goal = row-y;
        } else if (row-y + root.row-h > root.scroll-goal + root.rows-h) {
            root.scroll-goal = min(root.max-scroll, row-y + root.row-h - root.rows-h);
        } else {
            return;
        }
        root.scroll = root.scroll-goal;
    }

    // Where the ring goes, in pane space, set here and only here.
    //
    // Set imperatively rather than bound, for a Slint reason worth knowing
    // (docs/slint-notes.md): a bound property's `animate` duration is read
    // when the property is next evaluated - the next frame - not when its
    // input changed. So a flag turned off and back on around a page swap, in
    // one callback, was never seen off, and the ring toured from the old
    // page's row to the new one's on every swap under a fade meant for
    // something else. An imperative set reads the duration at the set, which
    // is how `scroll` has always worked; the ring now works the same way, and
    // `anim` is read here, now.
    function place-ring() {
        if (root.focus-row < root.first-room-row) {
            fs.ring-y = root.ring-bleed;
            fs.ring-h = root.strip-h;
            fs.ring-r = Theme.r-card;
        } else if (root.focus-row >= root.scenes-row) {
            fs.ring-y = root.scenes-y + root.ring-bleed;
            fs.ring-h = root.scenes-card-h;
            fs.ring-r = Theme.r-card;
        } else {
            fs.ring-y = root.rooms-y + root.ring-bleed - root.scroll-goal
                + (root.focus-row - root.first-room-row) * root.row-pitch;
            fs.ring-h = root.row-h;
            fs.ring-r = Theme.r-row;
        }
    }

    // The focus ring is ONE element for the whole pane, not one per section.
    //
    // Three rings meant three `focused` expressions over focus-row, and all of
    // them re-evaluated on every move - including moves between rooms, where
    // two of the three answer false before and after. Naming the expressions
    // does not help: Slint propagates on dependency, not on value. And those
    // two rings sit at the very top and the very bottom of the pane, so past
    // three dirty rectangles Slint merges, and the merge of "something at the
    // top, something at the bottom" is the whole pane: 452x654, ~23ms, at the
    // front of every single move. Bisected by disabling readers one at a time -
    // with the rooms ring alone, that frame does not happen.
    //
    // One ring, one band, and now no reader at all: the geometry lives on a
    // zero-size element so that recomputing it cannot dirty the root, which
    // is what paints the background, and it is bound to nothing - focus-row,
    // scroll and the models are read by place-ring() when it is called, so
    // the ring repaints only when it is told to move.
    fs := Rectangle {
        width: 0px;
        height: 0px;
        property <length> ring-y: 0px;
        property <length> ring-h: 90px;
        property <length> ring-r: Theme.r-row;
        // Match the scrolling curve so the outline stays on its moving row.
        animate ring-y, ring-h {
            duration: root.anim ? 160ms : 0ms;
            easing: ease-out;
        }
    }

    background: Theme.bg;

    VerticalLayout {
        padding-left: Theme.pad-side - root.ring-bleed;
        padding-right: Theme.pad-side - root.ring-bleed;
        spacing: root.gap;

        // A summary, and one focus stop.
        //
        // This was a two-wide horizontal scroller, which meant left and right
        // had to mean "move within this row" here and "change area" one row
        // down. That mode was the cause of every navigation fault this screen
        // has had. As one stop, left and right mean the same thing everywhere
        // and OK opens what is playing - directly if there is one thing, as a
        // list if there are several.
        if root.activities.length > 0: Rectangle {
            height: root.strip-h + 2 * root.ring-bleed;
            Rectangle {
                x: root.ring-bleed;
                y: root.ring-bleed;
                width: root.width - 2 * Theme.pad-side;
                height: root.strip-h;
                background: Theme.surface-raised;
                border-width: 1px;
                border-color: Theme.border-raised;
                border-radius: Theme.r-card;
                TouchArea { clicked => { root.pick(0); root.open-strip(); } }

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        if root.activities[0].kind == 0: HorizontalLayout {
                            spacing: 3px;
                            alignment: center;
                            Rectangle { width: 3px; height: 10px; background: Theme.accent; }
                            Rectangle { width: 3px; height: 16px; background: Theme.accent; }
                            Rectangle { width: 3px; height: 7px; background: Theme.accent; }
                        }
                        if root.activities[0].kind != 0: Image {
                            source: @image-url("../../assets/glyph-play.png");
                            width: 14px; height: 18px;
                            colorize: Theme.accent;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.activities.length == 1
                                ? root.activities[0].title
                                : root.activities.length + " activities";
                            font-size: 21px;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: root.activities.length == 1
                                ? root.activities[0].source + " · " + root.activities[0].place
                                : root.activities[0].title + " · and more";
                            font-size: 14px;
                            letter-spacing: 0.06 * 14px;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // The layout gives this box everything the fixed blocks leave; the
        // window inside it is sized by the arithmetic above, which agrees.
        roomsbox := Rectangle {
            Rectangle {
                y: 0px;
                height: root.rows-h + 2 * root.ring-bleed;
                clip: true;
                Rectangle {
                    y: root.ring-bleed - root.scroll;
                    height: max(0px, root.rooms.length * root.row-pitch - root.row-gap);
                    VerticalLayout {
                        spacing: root.row-gap;
                        padding-left: root.ring-bleed;
                        padding-right: root.ring-bleed;
                        for area[i] in root.rooms: Rectangle {
                            height: root.row-h;
                            TouchArea { clicked => { root.pick(root.first-room-row + i); } }
                            background: area.idle ? Theme.surface-idle : Theme.surface;
                            border-width: 1px;
                            border-color: area.idle ? Theme.border-idle : Theme.border;
                            border-radius: Theme.r-row;

                            HorizontalLayout {
                                padding: 18px;
                                spacing: 16px;

                                // Same component the device row and the light
                                // screen use, so the hub's other lift start
                                // hands over onto it with nothing to fade
                                // (docs/slint-notes.md). power-state -1 is
                                // "not answered", 0 is "answered, off", 1 is
                                // "answered, on" - known is true whenever the
                                // room has answered at all.
                                DeviceDisc {
                                    icon: area.icon;
                                    active: area.power-state > 0;
                                    known: area.power-state >= 0;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: area.name;
                                        font-size: 26px;
                                        font-weight: 600;
                                        color: area.idle ? Theme.text-secondary : Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: area.detail == "" ? area.devices
                                                                : area.devices + " · " + area.detail;
                                        font-size: 19px;
                                        color: area.idle ? Theme.text-quaternary : Theme.text-secondary;
                                        overflow: elide;
                                    }
                                }

                                // Status column. The design calls for a glow
                                // behind the dot; on the software renderer that
                                // is a blur we cannot afford, so the documented
                                // substitute is a 1px accent ring.
                                if area.status-known: VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    horizontal-stretch: 0;
                                    if !area.idle && !area.offline: Rectangle {
                                        width: 19px; height: 19px;
                                        background: transparent;
                                        border-radius: 9.5px;
                                        border-width: 1px;
                                        border-color: Theme.accent.with-alpha(0.4);
                                        Rectangle {
                                            width: 9px; height: 9px;
                                            border-radius: 4.5px;
                                            background: Theme.accent;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                    Text {
                                        text: area.offline ? "OFFLINE"
                                            : area.idle ? "IDLE"
                                            : (area.active-count + " ON");
                                        font-size: 14px;
                                        horizontal-alignment: right;
                                        // A dim room is on, so it keeps the
                                        // accent and only loses weight; the
                                        // idle branch has no level to recess.
                                        color: area.offline ? Theme.text-quaternary
                                            : area.idle ? Theme.text-quaternary
                                            : area.dimmed ? Theme.accent.with-alpha(0.55)
                                            : Theme.accent;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // The pager's slot. Empty: the hub draws into it, so the dots stay put
        // while the page behind them slides.
        Rectangle { height: root.dots-h; }

        // Inset to the cards' edge. Not an `x:` on the label itself: a child
        // of a VerticalLayout has its x replaced by the layout's padding, and
        // the compiler says nothing - measured, the ink started at 14px where
        // the cards start at 20px. Inside a plain Rectangle an x is honoured.
        Rectangle {
            height: root.label-h;
            SectionLabel {
                x: root.ring-bleed;
                y: 0px;
                height: root.label-h;
                text: "SCENES";
            }
        }

        // One stop, for the same reason as the strip above.
        Rectangle {
            height: root.scenes-card-h + 2 * root.ring-bleed;
            Rectangle {
                x: root.ring-bleed;
                y: root.ring-bleed;
                width: root.width - 2 * Theme.pad-side;
                height: root.scenes-card-h;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.r-card;
                TouchArea { clicked => { root.pick(root.scenes-row); root.open-scenes(); } }

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.scenes.length == 1 ? root.scenes[0].name
                                                          : root.scenes.length + " scenes";
                            font-size: 21px;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Image {
                            source: @image-url("../../../../assets/lucide/arrow-big-right.svg");
                            width: 22px; height: 22px;
                            colorize: Theme.text-secondary;
                        }
                    }
                }
            }
        }

    }

    // Drawn last so it is never behind a card, and outside the scrolling
    // viewport so a scroll and a focus move do not have to be reconciled -
    // ring-y is in pane space with the scroll already taken off.
    Rectangle {
        x: Theme.pad-side;
        y: fs.ring-y;
        width: root.width - 2 * Theme.pad-side;
        height: fs.ring-h;
        background: transparent;
        // The page arriving carries no ring: the old page takes its ring away
        // with it, and the new one's lands when the page has arrived, and a
        // landing straight after 180ms of motion reads as a stutter unless it
        // fades in. So: gone at once when hidden - the host renders the new
        // page exactly once with this true, and that frame must have no ring
        // on it - and 200ms back.
        //
        // A binding's animation reads its duration when the property is next
        // evaluated, not when the input changed (docs/slint-notes.md), which
        // is what makes this safe: the hidden frame is always rendered before
        // the flag comes back, so each duration is read under the flag it is
        // for.
        opacity: root.ring-hidden ? 0 : 1;
        animate opacity {
            duration: root.ring-hidden ? 0ms : 200ms;
            easing: ease-out;
        }
        FocusRing {
            focused: true;
            radius-inner: fs.ring-r;
            box-width: parent.width;
            box-height: parent.height;
        }
    }
}

export component HomeHub inherits Rectangle {
    callback pick(int);
    callback open-strip();
    callback open-room(int);
    callback open-scenes();
    in property <[LiveActivity]> activities;
    in property <[RoomRow]> rooms;
    in property <[SceneCell]> scenes;
    in property <int> area-index;
    // A model purely to count dots; Slint has no numeric range loop.
    in property <[bool]> area-dots;

    in property <int> focus-row;
    // The host has the page's ring hidden while it composes a transition.
    in property <bool> ring-hidden: false;
    // The page's row arithmetic, for the shell to wrap around with.
    out property <int> first-room-row: front.first-room-row;
    out property <int> row-count: front.row-count;
    // Where the pager is, in the hub's own space, for the host to hold those
    // rows still while it slides the page under them. Arithmetic over the
    // layout's padding and the pane's own figure, not read back off the
    // laid-out dots.
    out property <length> dots-y: Theme.pad-top + front.dots-y;
    out property <length> dots-h: front.dots-h;

    // Measured off our own height rather than the parent's, which a component
    // root cannot see. The strip is conditional, and so is the gap above it.
    property <length> pane-h: root.height - Theme.pad-top - Theme.pad-bottom;

    // One pane. A page change replaces its models in one go and the host
    // slides between the frame before and the frame after - a copy per frame.
    // There was a second pane for the incoming page, on a strip that
    // animated, with a timer to build the page before the first moving frame
    // and another to adopt it after the last: every frame rasterised both
    // pages, 10-29ms, over a 16.7ms budget. The pager stays here because it
    // is the control, and it belongs to the hub, not to a page.
    public function follow-focus() { front.follow-focus(); }
    public function land() { front.land(); }
    /// OK.
    public function activate() { front.activate(); }

    background: Theme.bg;

    VerticalLayout {
        padding-top: Theme.pad-top;
        padding-bottom: Theme.pad-bottom;

        Rectangle {
            front := AreaPane {
                x: 0px;
                y: 0px;
                width: root.width;
                height: root.pane-h;
                activities: root.activities;
                rooms: root.rooms;
                scenes: root.scenes;
                focus-row: root.focus-row;
                ring-hidden: root.ring-hidden;
                pick(r) => { root.pick(r); }
                open-strip => { root.open-strip(); }
                open-room(i) => { root.open-room(i); }
                open-scenes => { root.open-scenes(); }
            }

            // The pager, over the slot the pane reserves between the rooms and
            // the scenes label. It belongs to the hub rather than to a page, so
            // it must not travel with one - hence positioned here rather than
            // laid out inside the pane, and held still by the host during a
            // transition, which asks where it is through dots-y.
            //
            // After the pane, because the pane paints an opaque background and
            // anything declared before it is painted out. With an explicit x
            // and width, because a HorizontalLayout given a y inside a plain
            // Rectangle does not size itself and lays out into nothing. Each of
            // those cost a deploy to find.
            HorizontalLayout {
                x: 0px;
                y: front.dots-y;
                width: parent.width;
                height: front.dots-h;
                spacing: 6px;
                alignment: center;
                for dot[i] in root.area-dots: Rectangle {
                    width: 6px; height: 6px;
                    border-radius: 3px;
                    background: i == root.area-index ? Theme.accent : Theme.border-raised;
                }
            }
        }
    }
}
