import { BottomTray } from "../components/bottom_tray.slint";
import { MediaBack } from "../widgets/media-back.slint";
import { Theme } from "../theme.slint";
export struct TvChoice { action:string, title:string, detail:string }
component Tile inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <image> icon;
    callback activate();
    background:Theme.surface-raised;border-radius:18px;
    Image {x:18px;y:16px;width:24px;height:24px;source:root.icon;colorize:Theme.accent;}
    Text {x:18px;y:48px;width:parent.width - 36px;height:30px;text:root.title;font-size:21px;color:Theme.text;font-weight:600;}
    Text {x:18px;y:81px;width:parent.width - 36px;height:26px;text:root.detail;font-size:17px;color:Theme.text-secondary;overflow:elide;}
    TouchArea {clicked=>{root.activate();}}
}
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> primary;
    callback activate();
    background:root.primary ? Theme.accent : Theme.surface-raised;border-radius:30px;
    Image {x:(parent.width - 28px)/2;y:(parent.height - 28px)/2;width:28px;height:28px;source:root.icon;colorize:root.primary ? Theme.bg : Theme.text;}
    TouchArea {clicked=>{root.activate();}}
}
export component Television inherits Rectangle {
    in property <bool> shown;
    in property <bool> android-tv;
    in property <bool> apple-tv;
    in property <bool> infrared;
    in property <bool> sonos;
    in property <bool> media-active;
    in property <string> media-title;
    in property <string> media-subtitle;
    in property <string> media-state;
    in property <string> media-app;
    in property <image> media-art;
    in property <bool> media-has-art;
    in property <string> media-position;
    in property <string> media-duration;
    in property <float> media-progress;
    in property <bool> media-has-duration;
    in property <bool> media-live;
    property <bool> media-view: (root.android-tv || root.apple-tv) && root.media-active;
    property <bool> streaming-tv: root.android-tv || root.apple-tv || root.infrared || root.sonos;
    in property <string> title;
    in property <string> status;
    in property <string> error;
    in property <string> source-name;
    in property <string> sound;
    in property <string> picture;
    in property <int> panel;
    property <int> displayed-panel: 0;
    in property <[TvChoice]> choices;
    callback action(string);
    changed panel => { if (root.panel > 0) { root.displayed-panel = root.panel; } }
    public function take-focus(){keys.focus();}
    background:Theme.bg;
    if root.media-view && root.media-has-art: Image {x:0px;y:0px;width:parent.width;height:parent.height;source:root.media-art;image-fit:cover;}
    // Keep explicit origins: a centered overlay leaves visible uncovered bands.
    if root.media-view && root.media-has-art: Rectangle {
        x:0px;y:0px;width:parent.width;height:parent.height;
        background:@linear-gradient(180deg, #00000090 0%, #00000020 20%, #000000c0 48%, #000000 78%);
    }
    if root.media-view && !root.media-has-art: Image {x:32px;y:166px;width:64px;height:64px;source:@image-url("../../../../assets/lucide/tv.svg");colorize:Theme.text-tertiary;}
    MediaBack {x:24px;y:22px;activate=>{root.action("close");}}
    Text {x:88px;y:27px;width:parent.width - 112px;height:27px;text:root.title;font-size:20px;color:Theme.text;font-weight:600;overflow:elide;}
    Text {x:88px;y:58px;width:parent.width - 112px;height:25px;text:root.status;font-size:16px;color:Theme.text-secondary;overflow:elide;}
    if !root.media-view: Rectangle {x:0px;y:0px;width:parent.width;height:420px;background:transparent;
    Image {x:32px;y:146px;width:52px;height:52px;source:root.sonos ? @image-url("../../../../assets/lucide/speaker.svg") : @image-url("../../../../assets/lucide/tv.svg");colorize:Theme.accent;}
    Text {x:32px;y:220px;width:parent.width - 64px;height:25px;text:root.sonos ? "SONOS" : root.infrared ? "INFRARED" : root.apple-tv ? "APPLE TV" : root.android-tv ? "ANDROID TV" : "NOW ON YOUR TV";font-size:16px;letter-spacing:2px;color:Theme.accent;}
    Text {x:32px;y:256px;width:parent.width - 64px;height:108px;text:root.source-name;font-size:40px;font-weight:700;wrap:word-wrap;overflow:elide;color:Theme.text;}
    Text {x:32px;y:370px;width:parent.width - 64px;height:32px;text:root.sonos ? "Playback controls the selected group" : root.infrared ? "Point the remote at your device" : root.apple-tv ? "Power sleeps Apple TV · Wake resumes it" : "Playback controls depend on the active app";font-size:16px;color:Theme.text-secondary;}
    }
    for icon[i] in [@image-url("../../../../assets/lucide/rewind.svg"),@image-url("../../../../assets/lucide/play.svg"),@image-url("../../../../assets/lucide/pause.svg"),@image-url("../../../../assets/lucide/fast-forward.svg")]: IconButton {
        visible:!root.infrared;
        x:40px+i*102px;y:root.media-view ? 554px : 424px;width:88px;height:64px;icon:(root.apple-tv || root.sonos) && i==0 ? @image-url("../../../../assets/lucide/skip-back.svg") : (root.apple-tv || root.sonos) && i==3 ? @image-url("../../../../assets/lucide/skip-forward.svg") : icon;primary:i==1;
        activate=>{root.action(i==0 ? ((root.apple-tv || root.sonos) ? "previous" : "rewind") : i==1 ? "play" : i==2 ? "pause" : ((root.apple-tv || root.sonos) ? "next" : "forward"));}
    }
    if !root.streaming-tv: Tile {x:24px;y:514px;width:210px;height:120px;title:"Input";detail:root.source-name;icon:@image-url("../../../../assets/lucide/hdmi-port.svg");activate=>{root.action("inputs");}}
    if !root.streaming-tv: Tile {x:246px;y:514px;width:210px;height:120px;title:"Picture";detail:root.picture;icon:@image-url("../../../../assets/lucide/sliders-horizontal.svg");activate=>{root.action("picture");}}
    if !root.streaming-tv: Tile {x:24px;y:646px;width:210px;height:120px;title:"Sound output";detail:root.sound;icon:@image-url("../../../../assets/lucide/speaker.svg");activate=>{root.action("sound");}}
    if !root.streaming-tv: Tile {x:246px;y:646px;width:210px;height:120px;title:"Apps";detail:"Open on TV";icon:@image-url("../../../../assets/lucide/layout-grid.svg");activate=>{root.action("apps");}}
    if root.android-tv && !root.media-view: Tile {x:24px;y:514px;width:210px;height:120px;title:"Previous";detail:"Previous item";icon:@image-url("../../../../assets/lucide/skip-back.svg");activate=>{root.action("previous");}}
    if root.android-tv && !root.media-view: Tile {x:246px;y:514px;width:210px;height:120px;title:"Next";detail:"Next item";icon:@image-url("../../../../assets/lucide/skip-forward.svg");activate=>{root.action("next");}}
    if root.android-tv && !root.media-view: Tile {x:24px;y:646px;width:210px;height:120px;title:"Stop";detail:"Stop playback";icon:@image-url("../../../../assets/lucide/square.svg");activate=>{root.action("stop");}}
    if root.android-tv && !root.media-view: Tile {x:246px;y:646px;width:210px;height:120px;title:"Apps";detail:"Your shortcuts";icon:@image-url("../../../../assets/lucide/layout-grid.svg");activate=>{root.action("apps");}}
    if root.media-view: Rectangle {x:32px;y:320px;width:parent.width - 64px;height:224px;background:transparent;
        Text {y:0px;width:parent.width;height:76px;text:root.media-title!="" ? root.media-title : root.media-app!="" ? root.media-app : root.source-name;font-size:32px;font-weight:700;wrap:word-wrap;overflow:elide;color:Theme.text;vertical-alignment:bottom;}
        Text {y:86px;width:parent.width;height:28px;text:root.media-subtitle;font-size:19px;overflow:elide;color:Theme.text-secondary;}
        Text {x:0px;y:130px;width:160px;height:28px;text:root.media-state;font-size:20px;font-weight:600;color:Theme.accent;overflow:elide;}
        Text {x:170px;y:130px;width:parent.width - 170px;height:28px;text:root.media-app;font-size:17px;color:Theme.text-secondary;horizontal-alignment:right;overflow:elide;}
        // A timeline describes received metadata only; it deliberately has no touch target.
        Text {x:root.media-live ? 18px : 0px;y:179px;width:180px;height:24px;text:root.media-live ? "Live" : root.media-position;font-size:18px;color:Theme.text;}
        if root.media-live: Rectangle {x:0px;y:186px;width:8px;height:8px;border-radius:4px;background:Theme.accent;}
        Text {x:180px;y:179px;width:parent.width - 180px;height:24px;text:root.media-live ? "" : root.media-has-duration ? root.media-duration : "Duration unavailable";font-size:17px;color:Theme.text-secondary;horizontal-alignment:right;}
        if root.media-has-duration && !root.media-live: Rectangle {y:214px;width:parent.width;height:5px;border-radius:2.5px;background:Theme.surface-icon;
            Rectangle {x:0px;y:0px;width:parent.width * max(0,min(1,root.media-progress));height:parent.height;border-radius:2.5px;background:Theme.accent;}
        }
    }
    if root.media-view: Rectangle {x:32px;y:644px;width:parent.width - 64px;height:90px;background:transparent;
        for icon[i] in [@image-url("../../../../assets/lucide/skip-back.svg"),@image-url("../../../../assets/lucide/skip-forward.svg"),@image-url("../../../../assets/lucide/square.svg")]: IconButton {
            x:i*82px;y:8px;width:70px;height:70px;icon:root.apple-tv ? (i==0 ? @image-url("../../../../assets/lucide/house.svg") : i==1 ? @image-url("../../../../assets/lucide/arrow-left.svg") : @image-url("../../../../assets/lucide/power.svg")) : icon;
            activate=>{root.action(root.apple-tv ? (i==0 ? "home" : i==1 ? "back" : "wake") : (i==0 ? "previous" : i==1 ? "next" : "stop"));}
        }
        Rectangle {x:256px;y:8px;width:parent.width - 256px;height:70px;border-radius:18px;background:Theme.surface-raised;
            Image {x:17px;y:23px;width:24px;height:24px;source:@image-url("../../../../assets/lucide/layout-grid.svg");colorize:Theme.accent;}
            Text {x:52px;y:22px;width:parent.width - 64px;height:28px;text:"Apps";font-size:22px;color:Theme.text;font-weight:600;}
            TouchArea {clicked=>{root.action("apps");}}
        }
    }
    if root.sonos: Tile {x:24px;y:514px;width:210px;height:120px;title:"Volume −";detail:"This speaker";icon:@image-url("../../../../assets/lucide/volume-1.svg");activate=>{root.action("volume-down");}}
    if root.sonos: Tile {x:246px;y:514px;width:210px;height:120px;title:"Volume +";detail:"This speaker";icon:@image-url("../../../../assets/lucide/volume-2.svg");activate=>{root.action("volume-up");}}
    if root.sonos: Tile {x:24px;y:646px;width:210px;height:120px;title:"Mute";detail:"Toggle this speaker";icon:@image-url("../../../../assets/lucide/volume-x.svg");activate=>{root.action("toggle-mute");}}
    if root.sonos: Tile {x:246px;y:646px;width:210px;height:120px;title:"Refresh";detail:"Playback and volume";icon:@image-url("../../../../assets/lucide/refresh-cw.svg");activate=>{root.action("retry");}}
    if root.apple-tv && !root.media-view: Tile {x:24px;y:514px;width:210px;height:120px;title:"Wake";detail:"Resume Apple TV";icon:@image-url("../../../../assets/lucide/power.svg");activate=>{root.action("wake");}}
    if root.apple-tv && !root.media-view: Tile {x:246px;y:514px;width:210px;height:120px;title:"Apps";detail:"Installed apps";icon:@image-url("../../../../assets/lucide/layout-grid.svg");activate=>{root.action("apps");}}
    if root.infrared: Tile {x:24px;y:424px;width:432px;height:120px;title:"Commands";detail:"Assigned to this device";icon:@image-url("../../../../assets/lucide/list.svg");activate=>{root.action("commands");}}
    tray := BottomTray {
        width: parent.width; height: parent.height;
        open: root.panel > 0;
        active: root.shown;
        dismiss => { root.action("dismiss"); }
        // Explicit bounds keep projected children relative to the inset surface.
        Rectangle { x: Theme.overlay-inset; y: tray.content-y; width: tray.content-width; height: tray.content-height;
            TouchArea { }
            Text {x:26px;y:24px;width:parent.width - 110px;height:36px;text:root.displayed-panel==1 ? "Choose an input" : root.displayed-panel==2 ? (root.infrared ? "Assigned commands" : root.android-tv ? "App shortcuts" : "TV apps") : root.displayed-panel==3 ? "Picture" : "Sound output";font-size:27px;color:#ffffff;font-weight:600;}
            IconButton {x:parent.width - 70px;y:20px;width:44px;height:44px;icon:@image-url("../../../../assets/lucide/x.svg");activate=>{root.action("dismiss");}}
            Text {x:26px;y:80px;width:parent.width - 52px;height:84px;wrap:word-wrap;text:root.displayed-panel==3 ? "Picture-mode changes are available through your TV’s on-screen settings." : root.choices.length==0 ? (root.infrared ? "Assign commands in Rooms & devices in the web UI." : root.android-tv ? "Add app shortcuts in Connections in the web UI." : "No choices available. Reconnect to refresh.") : "Select by touch. Physical buttons continue to control the TV.";font-size:19px;color:Theme.text-secondary;}
            Flickable {x:24px;y:176px;width:parent.width - 48px;height:parent.height - 198px;viewport-height:root.choices.length*82px;viewport-width:self.width;
                for item[i] in root.choices: Rectangle {x:0px;y:i*82px;width:parent.width;height:74px;background:Theme.surface-raised;border-radius:12px;
                    Text {x:16px;y:10px;width:parent.width - 32px;height:29px;text:item.title;font-size:21px;color:#ffffff;overflow:elide;}
                    Text {x:16px;y:43px;width:parent.width - 32px;height:22px;text:item.detail;font-size:16px;color:Theme.text-secondary;overflow:elide;}
                    TouchArea {clicked=>{root.action(item.action);}}
                }
            }
        }
    }
    if root.error!="": Rectangle {x:24px;y:112px;width:parent.width - 48px;height:230px;background:Theme.surface-raised;border-radius:18px;
        Text {x:20px;y:16px;width:parent.width - 40px;height:138px;text:root.error;wrap:word-wrap;color:#ffffff;font-size:20px;}
        Rectangle {x:20px;y:170px;width:parent.width - 40px;height:44px;background:Theme.accent;border-radius:12px;Text {width:parent.width;height:parent.height;text:root.infrared ? "Reload commands" : "Reconnect";color:Theme.bg;horizontal-alignment:center;vertical-alignment:center;font-size:20px;}TouchArea {clicked=>{root.action("retry");}}}
    }
    keys:=FocusScope {enabled:root.shown;key-pressed(e)=>{
        if(e.text==Key.UpArrow){root.action("up");}
        if(e.text==Key.DownArrow){root.action("down");}
        if(e.text==Key.LeftArrow){root.action("left");}
        if(e.text==Key.RightArrow){root.action("right");}
        if(e.text==Key.Return){root.action("ok");}
        if(e.text==Key.Home){root.action("home");}
        if(e.text==Key.Escape){root.action("back");}
        if(e.text==Key.F13){root.action("power");}
        if(!root.apple-tv && e.text==Key.F14){root.action("toggle-mute");}
        if(!root.apple-tv && e.text==Key.F15){root.action("red");}
        if(!root.apple-tv && e.text==Key.F16){root.action("green");}
        if(!root.apple-tv && e.text==Key.F17){root.action("blue");}
        if(!root.apple-tv && e.text==Key.F18){root.action("yellow");}
        if(e.text==Key.F23){root.action("volume-up");}
        if(e.text==Key.F24){root.action("volume-down");}
        if(e.text==Key.F21){root.action("channel-up");}
        if(e.text==Key.F22){root.action("channel-down");}
        return accept;
    }}
}
