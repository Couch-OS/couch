import { BottomTray } from "../components/bottom_tray.slint";
import { MediaBack } from "../widgets/media-back.slint";
import { Theme } from "../theme.slint";
export struct PlayerChoice { title: string, detail: string }
component Control inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback activate();
    border-radius: root.primary ? 44px : 14px;
    background: root.primary ? Theme.accent : Theme.surface-raised;
    border-width: root.selected ? 3px : 1px;
    // The primary button is filled with the accent, so both of its edges are the
    // colour that reads *on* the accent: none at all when idle, and when selected
    // the same one its glyph uses. The others carry the ordinary raised edge.
    border-color: root.selected ? (root.primary ? Theme.bg : Theme.accent)
                                : (root.primary ? transparent : Theme.border-raised);
    opacity: root.enabled ? 1 : 0.35;
    Image { source:root.icon; width:root.primary ? 36px : 27px; height:self.width; x:(parent.width - self.width)/2; y:root.label=="" ? (parent.height - self.height)/2 : 13px; colorize:root.primary ? Theme.bg : Theme.text; }
    if root.label!="": Text { text:root.label; y:44px; width:parent.width; horizontal-alignment:center; font-size:17px; color:Theme.text; }
    TouchArea { enabled:root.enabled; clicked=>{root.activate();} }
}
export component Cinema inherits Rectangle {
    in property <bool> shown;
    in property <bool> ready;
    in property <bool> connected;
    in property <bool> paused;
    in property <bool> can-seek;
    in property <bool> has-art;
    in property <bool> has-logo;
    in property <image> fanart;
    in property <image> logo;
    in property <string> activity;
    in property <string> room;
    in property <string> title;
    in property <string> metadata;
    in property <string> elapsed;
    in property <string> remaining;
    in property <string> message;
    in property <float> progress;
    in property <int> panel;
    property <int> displayed-panel: 0;
    in property <string> panel-detail;
    in property <[PlayerChoice]> choices;
    // A music player (Sonos): track skips instead of time skips, sources,
    // play modes and up-next instead of chapters, audio and subtitles, and
    // the D-pad moves an on-screen selection because there is no player UI
    // on a TV to send it to.
    in property <bool> music;
    in property <[string]> sheets: ["Chapters","Audio","Subtitles"];
    callback action(string,float);
    in-out property <int> selected:-1;
    property <int> choice-index:0;
    property <float> seek-preview:0;
    property <length> list-scroll:max(0,root.choice-index - 4)*84px;
    animate list-scroll { duration:160ms; easing:ease-out; }
    changed panel=>{if(root.panel>0){root.choice-index=0;root.displayed-panel=root.panel;}}
    changed shown=>{if(!root.music){root.selected=-1;}}
    public function set-choice(i: int){ root.choice-index=max(0,min(root.choices.length - 1,i)); }
    public function take-focus(){ keys.focus(); }
    background:Theme.bg;
    if root.has-art: Image { source:root.fanart; width:parent.width;height:parent.height;image-fit:cover; }
    MediaBack {x:24px;y:22px;activate=>{root.action("back",0);}}
    Text {x:88px;y:24px;width:parent.width - 120px;height:26px;text:root.activity;font-size:19px;font-weight:600;color:Theme.text;overflow:elide;}
    // Full strength, not the secondary tone: this line is painted straight onto
    // the artwork in the brightest band of the frame, where a mid grey sinks into
    // the picture. Its size and weight already separate it from the title.
    Text {x:88px;y:52px;width:parent.width - 120px;height:22px;text:root.room;font-size:15px;color:Theme.text;overflow:elide;}
    if root.ready: Rectangle {
        background:transparent;x:32px;y:290px;width:parent.width - 64px;height:160px;
        if root.has-logo: Image {source:root.logo;width:parent.width;height:125px;image-fit:contain;horizontal-alignment:left;}
        if !root.has-logo: Text {text:root.title;width:parent.width;height:125px;font-size:36px;font-weight:700;color:Theme.text;wrap:word-wrap;overflow:elide;vertical-alignment:bottom;}
        Text {text:root.metadata;y:135px;width:parent.width;height:25px;font-size:16px;color:Theme.text-secondary;overflow:elide;}
    }
    if root.ready: Rectangle {
        x:32px;y:parent.height - 330px;width:parent.width - 64px;height:300px;background:transparent;
        Text {x:0px;y:0px;height:27px;text:root.elapsed;font-size:18px;color:Theme.text;}
        Text {x:0px;y:0px;height:27px;text:root.remaining;width:parent.width;horizontal-alignment:right;font-size:18px;color:Theme.text-secondary;}
        Rectangle {y:47px;width:parent.width;height:5px;border-radius:3px;background:Theme.text-quaternary;
            Rectangle {x:0px;width:parent.width*(seek-touch.pressed || root.selected==1 ? root.seek-preview : root.progress)/100;height:parent.height;background:Theme.accent;border-radius:3px;}
        }
        Rectangle {visible:root.selected==1;y:30px;width:parent.width;height:38px;border-width:2px;border-color:Theme.accent;border-radius:8px;background:transparent;}
        seek-touch:=TouchArea {y:27px;width:parent.width;height:48px;enabled:root.can-seek;
            pointer-event(e)=>{if(e.kind==PointerEventKind.down){root.seek-preview=max(0,min(100,self.mouse-x/self.width*100));}if(e.kind==PointerEventKind.up){root.action("seek",root.seek-preview);}}
            moved=>{if(self.pressed){root.seek-preview=max(0,min(100,self.mouse-x/self.width*100));}}
        }
        if !root.music: Control {x:38px;y:93px;width:70px;height:70px;icon:@image-url("../../../../assets/lucide/rotate-ccw.svg");label:"10s";enabled:root.can-seek;selected:root.selected==2;activate=>{root.action("skip",-10);}}
        if root.music: Control {x:38px;y:93px;width:70px;height:70px;icon:@image-url("../../../../assets/lucide/skip-back.svg");selected:root.selected==2;activate=>{root.action("previous",0);}}
        Control {x:(parent.width - 88px)/2;y:84px;width:88px;height:88px;primary:true;icon:root.paused ? @image-url("../../../../assets/lucide/play.svg") : @image-url("../../../../assets/lucide/pause.svg");selected:root.selected==3;activate=>{root.action("play",0);}}
        if !root.music: Control {x:parent.width - 108px;y:93px;width:70px;height:70px;icon:@image-url("../../../../assets/lucide/rotate-cw.svg");label:"30s";enabled:root.can-seek;selected:root.selected==4;activate=>{root.action("skip",30);}}
        if root.music: Control {x:parent.width - 108px;y:93px;width:70px;height:70px;icon:@image-url("../../../../assets/lucide/skip-forward.svg");selected:root.selected==4;activate=>{root.action("next",0);}}
        for label[i] in root.sheets: Control {x:i*(parent.width+10px)/3;y:198px;width:(parent.width - 20px)/3;height:76px;label:label;selected:root.selected==i+5;
            icon:root.music ? (i==0 ? @image-url("../../../../assets/lucide/list-music.svg") : i==1 ? @image-url("../../../../assets/lucide/shuffle.svg") : @image-url("../../../../assets/lucide/list-ordered.svg"))
                : (i==0 ? @image-url("../../../../assets/lucide/list-video.svg") : i==1 ? @image-url("../../../../assets/lucide/audio-lines.svg") : @image-url("../../../../assets/lucide/captions.svg"));
            activate=>{root.action(i==0 ? "chapters" : i==1 ? "audio" : "subtitles",0);}}
    }
    if !root.ready: Rectangle {x:36px;y:220px;width:parent.width - 72px;height:310px;background:transparent;
        Text {text:root.title;width:parent.width;height:170px;wrap:word-wrap;font-size:27px;color:Theme.text;horizontal-alignment:center;vertical-alignment:center;}
        if !root.connected: Control {x:60px;y:195px;width:parent.width - 120px;height:78px;label:"Reconnect";selected:root.selected==3;icon:@image-url("../../../../assets/lucide/rotate-cw.svg");activate=>{root.action("retry",0);}}
    }
    tray := BottomTray {
        width: parent.width; height: parent.height;
        open: root.panel > 0;
        active: root.shown;
        dismiss => { root.action("back",0); }
        // Explicit bounds keep projected children relative to the inset surface.
        Rectangle { x: Theme.overlay-inset; y: tray.content-y; width: tray.content-width; height: tray.content-height;
            TouchArea { }
            Text {x:28px;y:26px;text:root.displayed-panel>=1 && root.displayed-panel<=3 ? root.sheets[root.displayed-panel - 1] : "TV controls";font-size:28px;color:Theme.text;}
            Control {x:parent.width - 76px;y:18px;width:48px;height:48px;icon:@image-url("../../../../assets/lucide/x.svg");activate=>{root.action("back",0);}}
            if root.panel-detail!="" && root.displayed-panel<4: Text {x:28px;y:110px;width:parent.width - 56px;height:250px;wrap:word-wrap;font-size:21px;color:Theme.text-secondary;text:root.panel-detail;}
            if root.displayed-panel<4: Rectangle {x:28px;y:105px;width:parent.width - 56px;height:412px;clip:true;background:transparent;
                for item[i] in root.choices: Rectangle {y:i*84px - root.list-scroll;width:parent.width;height:76px;background:Theme.surface-raised;border-radius:12px;border-width:root.choice-index==i ? 2px : 0px;border-color:Theme.accent;
                    Text {x:18px;y:12px;width:parent.width - 36px;height:28px;text:item.title;overflow:elide;font-size:22px;color:Theme.text;}
                    Text {x:18px;y:43px;width:parent.width - 36px;height:22px;text:item.detail;font-size:16px;color:Theme.text-secondary;overflow:elide;}
                    TouchArea {clicked=>{root.choice-index=i;root.action("choose",i);}}
                }
            }

        }
    }
    if root.message!="": Rectangle {x:24px;y:parent.height - 150px;width:parent.width - 48px;height:100px;border-radius:16px;background:Theme.surface-raised;
        Text {x:16px;y:12px;width:parent.width - 32px;height:parent.height - 24px;text:root.message;wrap:word-wrap;font-size:20px;color:Theme.text;}
    }
    keys:=FocusScope {enabled:root.shown;
        key-pressed(e)=>{
            // A music player's sheet is a list on this screen: the D-pad
            // walks it and OK picks, instead of going to a remote player.
            if(root.music && root.panel>0){
                if(e.text==Key.UpArrow){root.choice-index=max(0,root.choice-index - 1);}
                if(e.text==Key.DownArrow){root.choice-index=min(max(0,root.choices.length - 1),root.choice-index+1);}
                if(e.text==Key.Return){root.action("choose",root.choice-index);}
                if(e.text==Key.Escape){root.action("back",0);}
                if(e.text==Key.Home){root.action("Input.Home",0);}
                if(e.text==Key.F14){root.action("mute",0);}
                if(e.text==Key.F23 || e.text==Key.F24){root.action("volume",e.text==Key.F23 ? 5 : -5);}
                return accept;
            }
            if(e.text==Key.UpArrow){root.action("Input.Up",0);}
            if(e.text==Key.DownArrow){root.action("Input.Down",0);}
            if(e.text==Key.LeftArrow){root.action("Input.Left",0);}
            if(e.text==Key.RightArrow){root.action("Input.Right",0);}
            if(e.text==Key.Return){root.action("Input.Select",0);}
            if(e.text==Key.Escape){root.action("Input.Back",0);}
            if(e.text==Key.Home){root.action("Input.Home",0);}
            if(e.text==Key.F14){root.action("mute",0);}
            if(e.text==Key.F23 || e.text==Key.F24){root.action("volume",e.text==Key.F23 ? 5 : -5);}
            if(e.text==Key.F21 || e.text==Key.F22){root.action("chapter-step",e.text==Key.F21 ? 1 : -1);}
            return accept;
        }
    }
}
