import { Theme } from "../theme.slint";

// First-run Wi-Fi provisioning. Not part of the design handoff - that scopes
// the hub - but the device cannot reach a hub without it, so it is built from
// the same tokens to sit alongside the rest.
export component Setup inherits Rectangle {
    in property <string> ssid;
    in property <string> portal-url;
    in property <image> qr;
    // 0 idle, 1 waiting for a button press, 2 granted, 3 timed out
    in property <int> approval: 0;

    background: Theme.bg;

    VerticalLayout {
        padding-top: 28px;
        padding-left: Theme.pad-side;
        padding-right: Theme.pad-side;
        spacing: 0px;
        alignment: start;

        Text {
            text: "Wi-Fi Setup";
            font-size: 26px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: "SCAN WITH YOUR PHONE CAMERA";
            font-size: 15px;
            letter-spacing: 0.14 * 15px;
            color: Theme.text-quaternary;
            horizontal-alignment: center;
        }

        Rectangle { height: 22px; }

        // A QR needs a light quiet zone to scan, so this one card stays white
        // in an otherwise very dark theme.
        //
        // The card is narrower than the column, and a child of a
        // VerticalLayout is laid out at the padding rather than centred - its
        // own x is overwritten - so it takes a row of its own to sit under the
        // centred text above it.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 320px;
                width: 320px;
                background: #FFFFFF;
                border-radius: Theme.r-row;
                // Sized from the source, not to a box. qr.rs scales by a whole
                // number of pixels per module so the module edges land on pixel
                // edges; drawing that into a fixed 288px box rescaled it by
                // 288/259 and put the edges back where they were. The card has
                // room to spare at every QR version this screen can produce, so
                // the image keeps its own size and is centred in it.
                Image {
                    source: root.qr;
                    width: self.source.width * 1px;
                    height: self.source.height * 1px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    image-rendering: pixelated;
                }
            }
        }

        Rectangle { height: 24px; }

        Text {
            text: "NETWORK - NO PASSWORD";
            font-size: 14px;
            letter-spacing: 0.14 * 14px;
            color: Theme.text-quaternary;
            horizontal-alignment: center;
        }
        Text {
            text: root.ssid;
            font-size: 26px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }

        Rectangle { height: 18px; }

        Text {
            text: "THEN OPEN";
            font-size: 14px;
            letter-spacing: 0.14 * 14px;
            color: Theme.text-quaternary;
            horizontal-alignment: center;
        }
        Text {
            text: root.portal-url;
            font-size: 19px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }

    // The portal demands a physical button press before granting SSH access,
    // and couch-system has no way to say so on the panel - its output goes to a
    // log, and this screen owns the display.
    if root.approval != 0: Rectangle {
        x: 24px;
        y: parent.height - self.height - 28px;
        width: parent.width - 48px;
        height: 108px;
        background: Theme.accent;
        border-radius: Theme.r-row;
        Text {
            width: parent.width;
            y: (parent.height - self.height) / 2;
            horizontal-alignment: center;
            // 21px, which the card titles already embed at this weight, rather
            // than the 20px this had: a size used once costs the whole charset
            // in the binary, and that one was 30KB for a banner nobody sees
            // twice.
            font-size: 21px;
            font-weight: 600;
            color: Theme.bg;
            text: root.approval == 1 ? "Press any button\nto approve SSH access"
                : root.approval == 2 ? "SSH access approved"
                : "Approval timed out";
        }
    }
}
