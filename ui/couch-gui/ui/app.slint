import { Camera } from "screens/camera.slint";
import { Thermostat } from "screens/thermostat.slint";
import { ActivityPages, ActivityTile } from "screens/activity_pages.slint";
export { ActivityTile }
import { Television, TvChoice } from "screens/tv.slint";
import { Cinema, PlayerChoice } from "screens/cinema.slint";
export { PlayerChoice, TvChoice }
import { Theme } from "theme.slint";
import { StatusBar } from "components/status_bar.slint";
import { VolumeOverlay } from "components/volume_overlay.slint";
import { PairOverlay } from "components/pair_overlay.slint";
import { MicOverlay } from "components/mic_overlay.slint";
import { Chooser, ChoiceItem } from "components/chooser.slint";
import { HomeHub, LiveActivity, RoomRow, SceneCell } from "screens/home_hub.slint";
import { Setup } from "screens/setup.slint";
import { Keyboard } from "components/keyboard.slint";
import { Settings } from "components/settings.slint";
import { RoomDevices } from "components/room_devices.slint";
import { WifiSetup } from "components/wifi_setup.slint";

export { LiveActivity, RoomRow, SceneCell }

export component App inherits Window {
    in-out property <bool> dock-clock-shown: false;
    in-out property <int> dock-clock-shift: 0;

    width: 480px;
    height: 800px;
    background: Theme.bg;
    in-out property <color> accent <=> Theme.accent;
    in-out property <color> accent-background <=> Theme.accent-bg;

    // --- shell ----------------------------------------------------------------
    in-out property <string> clock: "--:--";
    in-out property <int> battery: 0;
    in-out property <bool> charging: false;
    in-out property <int> wifi-level: 0;
    in-out property <string> wifi-signal: "—";

    // --- hub data -------------------------------------------------------------
    in-out property <[LiveActivity]> activities;
    in-out property <[RoomRow]> rooms;
    in-out property <[SceneCell]> scenes;
    in-out property <string> area-name: "HOME";
    in-out property <int> area-index: 0;
    in-out property <[bool]> area-dots;
    callback area-step(int);

    // A page change is not animated here. The host keeps the frame on the
    // panel, applies the change as an instant state change with this set,
    // renders that once, and slides the old frame out and the new one in by
    // copying - a memcpy a frame where re-rasterising two pages was up to
    // 29ms (src/panel.rs). Then it clears this and the ring fades in.
    in-out property <bool> ring-hidden: false;
    /// The rows above the page, which a transition holds still.
    out property <length> status-h: 56px;
    /// The pager's band in window space, held still through an area change:
    /// it is the control, and should not travel with the thing it controls.
    out property <length> dots-y: root.status-h + hub.dots-y;
    out property <length> dots-h: hub.dots-h;

    // --- interaction ----------------------------------------------------------
    // A single top-level FocusScope driving an integer index, rather than Slint's
    // per-element focus: the hardware D-pad delivers key codes globally, and the
    // ring is explicitly authored in reading order rather than derived from
    // geometry. It also makes "restore focus per screen" a matter of keeping an
    // integer, which is what returning from a room view needs.
    //
    // The ring is one flat list of stops - the activity strip, each room, the
    // scenes row - so up and down are the only keys that move focus, and left
    // and right mean the same thing everywhere: change area. What a row index
    // means is the hub's business (see AreaPane); the host is told what was
    // opened, never which row.
    in-out property <int> focus-row: 0;
    callback open-strip();
    callback open-room(int);
    callback open-scenes();
    callback back();
    callback home();

    /// OK on whatever has focus. Also what COUCH_OPEN presses.
    public function activate() { hub.activate(); }
    /// The host parked focus somewhere (COUCH_FOCUS, COUCH_NAV): scroll to
    /// match and glide the ring there, as a key press would.
    public function settle-focus() { hub.follow-focus(); }
    /// The host has replaced the page's models: focus its first room and land
    /// the ring there, nothing travelling.
    public function page-swapped() {
        root.focus-row = hub.first-room-row;
        hub.land();
    }
    // The hub's row count, for COUCH_NAV to walk the ring with.
    out property <int> row-count: hub.row-count;

    function move(delta: int) {
        if (hub.row-count <= 0) { return; }
        root.focus-row = Math.mod(root.focus-row + delta + hub.row-count, hub.row-count);
        hub.follow-focus();
    }

    // --- first-run setup ------------------------------------------------------
    in-out property <bool> setup-mode: false;
    in-out property <string> ssid: "Couch-Setup";
    in-out property <string> portal-url: "http://192.168.4.1";
    in-out property <image> qr;
    in-out property <int> approval: 0;

    // --- chooser --------------------------------------------------------------
    // Opened by OK on the activity strip or the scenes row. While it is up it
    // owns up, down, OK and back; nothing else on the hub moves.
    in-out property <bool> chooser-shown: false;
    in-out property <string> chooser-title;
    in-out property <[ChoiceItem]> chooser-items;
    in-out property <int> chooser-index: 0;
    callback chosen(int);
    /// Escape, or Left and Right, inside the list. A callback rather than a
    /// write to chooser-shown: closing is a page transition, and that is the
    /// host's to perform once this key's dispatch has returned.
    callback close-chooser();

    in-out property <bool> custom-activity-shown: false;
    in-out property <bool> custom-activity-available: false;
    in-out property <bool> custom-activity-source: false;
    in-out property <bool> custom-activity-busy: false;
    in-out property <string> custom-activity-title;
    in-out property <string> custom-activity-status;
    in-out property <[ActivityTile]> custom-activity-tiles;
    in-out property <int> custom-activity-page;
    in-out property <int> custom-activity-count;
    callback custom-activity-action(string,int);
    callback open-activity(string);
    callback open-activity-ready(string);
    callback end-activity();
    callback cancel-activity();
    in-out property <bool> activity-busy;
    in-out property <bool> activity-running;
    in-out property <bool> activity-keep-awake;
    in-out property <string> activity-progress;
    in-out property <string> activity-step;
    callback open-tv(string,string);
    callback open-thermostat(string, string);
    callback thermostat-room-adjust(string, string, int);
    callback thermostat-action(string, int);
    in-out property <bool> thermostat-feedback-shown;
    in-out property <string> thermostat-feedback-name;
    in-out property <string> thermostat-feedback-value;
    in-out property <bool> camera-shown;
    in-out property <string> camera-title;
    in-out property <string> camera-message;
    in-out property <image> camera-image;
    callback open-camera(string,string);
    callback close-camera();
    public function focus-camera(){camera-page.take-focus();}
    in-out property <bool> thermostat-shown;
    in-out property <string> thermostat-title;
    // Runtime HA values include these glyphs. Software font embedding scans
    // Slint literals, so retain degree, range dash and unknown placeholders.
    in-out property <string> thermostat-current: "—°C";
    in-out property <string> thermostat-target: "—°C – —°C";
    in-out property <string> thermostat-status;
    in-out property <string> thermostat-detail;
    in-out property <string> thermostat-mode;
    in-out property <[string]> thermostat-modes;
    in-out property <bool> thermostat-range;
    in-out property <bool> thermostat-adjustable;
    in-out property <bool> thermostat-pending;
    in-out property <bool> thermostat-modes-shown;
    public function focus-thermostat() { thermostat-page.take-focus(); }
    callback tv-action(string);
    in-out property <bool> tv-shown: false;
    in-out property <bool> tv-android: false;
    in-out property <bool> tv-apple: false;
    in-out property <bool> tv-ir: false;
    in-out property <bool> tv-sonos: false;
    in-out property <bool> tv-media-active: false;
    in-out property <string> tv-media-title;
    in-out property <string> tv-media-subtitle;
    in-out property <string> tv-media-state;
    in-out property <string> tv-media-app;
    in-out property <image> tv-media-art;
    in-out property <bool> tv-media-has-art: false;
    in-out property <string> tv-media-position;
    in-out property <string> tv-media-duration;
    in-out property <float> tv-media-progress;
    in-out property <bool> tv-media-has-duration: false;
    in-out property <bool> tv-media-live: false;
    in-out property <string> tv-title;
    in-out property <string> tv-status;
    in-out property <string> tv-error;
    in-out property <string> tv-source;
    in-out property <string> tv-sound;
    in-out property <string> tv-picture;
    in-out property <int> tv-panel;
    in-out property <[TvChoice]> tv-choices;
    public function focus-tv(){television.take-focus();}
    callback player-action(string,float);
    in-out property <string> active-activity;
    in-out property <bool> player-shown: false;
    in-out property <bool> player-ready: false;
    in-out property <bool> player-connected: false;
    in-out property <bool> player-paused: false;
    in-out property <bool> player-can-seek: false;
    in-out property <bool> player-has-art: false;
    in-out property <bool> player-has-logo: false;
    in-out property <image> player-fanart;
    in-out property <image> player-logo;
    in-out property <string> player-activity;
    in-out property <string> player-room;
    in-out property <string> player-title;
    in-out property <string> player-metadata;
    in-out property <string> player-elapsed;
    in-out property <string> player-remaining;
    in-out property <string> player-message;
    in-out property <float> player-progress;
    in-out property <int> player-panel: 0;
    in-out property <string> player-panel-detail;
    in-out property <[PlayerChoice]> player-choices;
    public function focus-player(){if(root.custom-activity-shown){custom-pages.take-focus();}else{cinema.take-focus();}}
    in-out property <bool> light-shown: false;
    in-out property <string> light-title;
    in-out property <string> light-detail;
    in-out property <[ChoiceItem]> light-items;
    callback light-activate(int);
    callback light-brightness(int, int);
    in-out property <bool> brightness-shown: false;
    in-out property <int> light-brightness-percent: 0;
    in-out property <string> brightness-target;
    in-out property <string> brightness-label: "Brightness";
    callback light-back();
    callback room-scenes();
    callback room-scene-step(int);
    in-out property <bool> scene-feedback-shown: false;
    in-out property <string> scene-feedback-name;
    in-out property <string> scene-feedback-status;
    in-out property <int> light-scene-count;
    in-out property <string> light-scene-label;
    in-out property <string> light-room-id;
    changed chooser-shown => { if (root.chooser-shown) { fs.focus(); } else if (root.light-shown) { light-page.take-focus(); } }
    public function focus-light() { light-page.take-focus(); }
    public function focus-home() { fs.focus(); }

    // --- keyboard -------------------------------------------------------------
    // The on-screen keyboard, over the hub. Instantiated only while shown: it
    // takes focus on creation, and the shell's FocusScope takes it back when
    // the keyboard leaves. Nothing on the hub opens it yet; COUCH_KEYBOARD
    // opens it at startup so it can be tried on the panel.
    in-out property <bool> keyboard-shown: false;
    in-out property <string> keyboard-title: "ENTER TEXT";
    in-out property <string> keyboard-placeholder: "";
    in-out property <bool> keyboard-password: false;
    callback keyboard-accepted(string);
    callback keyboard-cancelled();
    public function open-keyboard() { root.keyboard-shown = true; }

    // --- settings -------------------------------------------------------------
    // Opened by a hold of the menu key on the home screen (the host times the
    // hold). A modal page over the hub, owning the D-pad while up.
    in-out property <bool> settings-shown: false;
    in-out property <int> setting-brightness: 100;
    in-out property <[string]> dim-choices;
    in-out property <int> dim-index: 0;
    in-out property <[string]> off-choices;
    in-out property <int> off-index: 0;
    in-out property <string> wifi-ssid: "";
    in-out property <bool> ssh-on: false;
    in-out property <bool> ssh-available: false;
    // A brief message, e.g. Wi-Fi progress. Non-empty shows it; the host clears it.
    in-out property <string> toast: "";
    in-out property <bool> feedback-enabled: true;
    callback setting-brightness-changed(int);
    callback setting-dim-changed(int);
    callback setting-off-changed(int);
    in-out property <bool> wifi-setup-shown: false;
    in-out property <string> wifi-setup-title;
    in-out property <string> wifi-setup-detail;
    in-out property <[ChoiceItem]> wifi-setup-items;
    callback wifi-setup-activate(int);
    callback wifi-setup-back();
    public function focus-wifi-setup() { wifi-setup.take-focus(); }
    callback setting-change-wifi();
    callback setting-recovery-wifi();
    in-out property <image> wifi-setup-qr;
    in-out property <bool> wifi-setup-has-qr: false;
    callback setting-toggle-ssh();
    // Which tier the settings menu shows (0 root, 1 display, 2 wifi, 3 ssh),
    // owned here so the host can slide between them. Enter and leave are asks.
    in-out property <int> settings-panel: 0;
    callback settings-enter(int);
    callback settings-leave();

    function chooser-move(delta: int) {
        if (root.chooser-items.length <= 0) { return; }
        root.chooser-index = Math.mod(root.chooser-index + delta + root.chooser-items.length,
                                      root.chooser-items.length);
    }

    // --- microphone -----------------------------------------------------------
    // The microphone is open. Driven by whether the capture thread is alive,
    // never by a flag - see src/mic.rs.
    in-out property <bool> recording: false;
    in-out property <float> mic-level: 0;
    in-out property <bool> mic-latched: false;

    // --- pairing --------------------------------------------------------------
    // A browser is asking to pair; the digits live only here and on that
    // browser's screen.
    in-out property <bool> pair-shown: false;
    in-out property <string> pair-pin: "";
    in-out property <int> pair-seconds: 0;

    // --- volume overlay -------------------------------------------------------
    in-out property <bool> volume-shown: false;
    in-out property <int> volume: 0;
    in-out property <string> volume-target: "";

    fs := FocusScope {
        key-pressed(e) => {
            if (root.chooser-shown) {
                if (e.text == Key.UpArrow)   { root.chooser-move(-1); return accept; }
                if (e.text == Key.DownArrow) { root.chooser-move(1);  return accept; }
                if (e.text == Key.Return) { root.chosen(root.chooser-index); return accept; }
                if (e.text == Key.Escape) { root.close-chooser(); return accept; }
                // Left and right change area everywhere else; inside a list
                // they would have nothing to do, so they close it.
                if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                    root.close-chooser();
                    return accept;
                }
                return accept;
            }
            if (e.text == Key.UpArrow)    { root.move(-1); return accept; }
            if (e.text == Key.DownArrow)  { root.move(1);  return accept; }
            if (e.text == Key.LeftArrow)  { root.area-step(-1); return accept; }
            if (e.text == Key.RightArrow) { root.area-step(1);  return accept; }
            if (e.text == Key.Return)  { root.activate(); return accept; }
            if (e.text == Key.Escape)  { root.back(); return accept; }
            if (e.text == Key.Home)    { root.home(); return accept; }
            return reject;
        }
    }
    init => { fs.focus(); }
    // The settings menu carries its own focus; when it closes - by the host's
    // slide, or because change-wifi handed off to the keyboard - the shell has
    // to take the D-pad back, or the hub stops responding.
    changed settings-shown => { if (!root.settings-shown && !root.keyboard-shown) { fs.focus(); } }

    if root.setup-mode: Setup {
        width: parent.width;
        height: parent.height;
        ssid: root.ssid;
        portal-url: root.portal-url;
        qr: root.qr;
        approval: root.approval;
    }

    if !root.setup-mode: StatusBar {
        y: 0;
        width: parent.width;
        clock: root.clock;
        title: root.light-shown && !root.chooser-shown ? root.light-title
             : root.wifi-setup-shown && !root.keyboard-shown ? "WI-FI"
             : root.settings-shown ? "SETTINGS"
             : root.keyboard-shown ? root.keyboard-title
             : root.chooser-shown ? root.chooser-title : root.area-name;
        battery: root.battery;
        charging: root.charging;
        wifi-level: root.wifi-level;
    }

    // The hub and whatever it opens, side by side on a strip. The chooser was
    // an overlay first; a sheet over a dimmed hub looked out of place in a UI
    // where everything else is a page, and a translucent scrim costs a
    // composite of the whole panel every frame where an opaque page is a
    // fill. Same motion as changing area, same duration, same layout.
    //
    // The strip jumps rather than animates: the slide between the frame
    // before the jump and the frame after it is composed by the host, see
    // ring-hidden above.
    Rectangle {
        visible: !root.setup-mode;
        y: root.status-h;
        width: parent.width;
        height: parent.height - root.status-h;
        clip: true;

        Rectangle {
            x: root.chooser-shown ? -root.width : 0px;
            width: root.width * 2;
            height: parent.height;

            hub := HomeHub {
                // Sized from the window, not from the parent: the parent is
                // the two-page strip and is twice as wide, and the viewport
                // above has already taken the status bar off the height.
                x: 0px;
                y: 0px;
                width: root.width;
                height: parent.height;
                activities: root.activities;
                rooms: root.rooms;
                scenes: root.scenes;
                area-index: root.area-index;
                area-dots: root.area-dots;
                focus-row: root.focus-row;
                ring-hidden: root.ring-hidden;
                pick(r) => {
                    root.focus-row = r;
                    hub.follow-focus();
                }
                open-strip => { root.open-strip(); }
                open-room(i) => { root.open-room(i); }
                open-scenes => { root.open-scenes(); }
            }

            Chooser {
                x: root.width;
                y: 0px;
                width: root.width;
                height: parent.height;
                shown: root.chooser-shown;
                title: root.chooser-title;
                items: root.chooser-items;
                index: root.chooser-index;
                // A tap on a row selects it and acts on it, the rule the
                // strip and the scenes card follow.
                pick(i) => { root.chooser-index = i; }
                choose(i) => { root.chosen(i); }
            }
        }
    }


    light-page := RoomDevices {
        x: root.light-shown && !root.chooser-shown ? 0px : root.width;
        y: root.status-h; width: root.width; height: root.height - root.status-h;
        shown: root.light-shown;
        detail: root.light-detail; items: root.light-items;
        scene-count: root.light-scene-count;
        scene-label: root.light-scene-label;
        open-scenes => {root.room-scenes();}
        scene-step(delta) => {root.room-scene-step(delta);}
        activate(i) => {root.light-activate(i);}
        brightness(i, delta) => {root.light-brightness(i, delta);}
        back => {root.light-back();}
    }

    television := Television {
        visible:root.tv-shown;shown:root.tv-shown;android-tv:root.tv-android;apple-tv:root.tv-apple;infrared:root.tv-ir;sonos:root.tv-sonos;
        width:parent.width;height:parent.height;
        title:root.tv-title;status:root.tv-status;error:root.tv-error;
        source-name:root.tv-source;sound:root.tv-sound;picture:root.tv-picture;panel:root.tv-panel;choices:root.tv-choices;
        media-active:root.tv-media-active;media-title:root.tv-media-title;media-subtitle:root.tv-media-subtitle;media-state:root.tv-media-state;media-app:root.tv-media-app;
        media-art:root.tv-media-art;media-has-art:root.tv-media-has-art;
        media-position:root.tv-media-position;media-duration:root.tv-media-duration;media-progress:root.tv-media-progress;
        media-has-duration:root.tv-media-has-duration;media-live:root.tv-media-live;
        action(name)=>{root.tv-action(name);}
    }
    cinema := Cinema {
        visible:root.player-shown && !root.custom-activity-shown;
        shown:root.player-shown && !root.custom-activity-shown;
        width:parent.width;height:parent.height;
        ready:root.player-ready;connected:root.player-connected;paused:root.player-paused;can-seek:root.player-can-seek;
        has-art:root.player-has-art;has-logo:root.player-has-logo;
        fanart:root.player-fanart;logo:root.player-logo;
        activity:root.player-activity;room:root.player-room;title:root.player-title;
        metadata:root.player-metadata;elapsed:root.player-elapsed;remaining:root.player-remaining;
        progress:root.player-progress;message:root.player-message;
        panel:root.player-panel;panel-detail:root.player-panel-detail;choices:root.player-choices;
        action(name,value)=>{root.player-action(name,value);}
    }

    custom-pages := ActivityPages {
        visible:root.player-shown && root.custom-activity-shown;
        shown:root.player-shown && root.custom-activity-shown;
        width:parent.width; height:parent.height;
        title:root.custom-activity-title; activity:root.player-activity;
        tiles:root.custom-activity-tiles; page:root.custom-activity-page; page-count:root.custom-activity-count;
        has-source:root.custom-activity-source; busy:root.custom-activity-busy; status:root.custom-activity-status;
        action(name,index)=>{root.custom-activity-action(name,index);}
    }
    thermostat-page := Thermostat {
        width:parent.width; height:parent.height;
        visible:root.thermostat-shown; shown:root.thermostat-shown;
        title:root.thermostat-title; current:root.thermostat-current; target:root.thermostat-target;
        status:root.thermostat-status; detail:root.thermostat-detail; mode:root.thermostat-mode;
        modes:root.thermostat-modes; modes-shown:root.thermostat-modes-shown;
        range:root.thermostat-range; adjustable:root.thermostat-adjustable; pending:root.thermostat-pending;
        action(name,index) => { root.thermostat-action(name,index); }
    }
    camera-page := Camera { x:0px;y:0px;width:parent.width;height:parent.height;visible:root.camera-shown;shown:root.camera-shown;title:root.camera-title;message:root.camera-message;frame:root.camera-image;close=>{root.close-camera();} }
    if root.custom-activity-available && root.active-activity!="" && !root.custom-activity-shown && (root.player-shown || root.tv-shown): Rectangle {
        x:parent.width - 112px; y:80px; width:88px; height:44px; border-radius:22px; background:Theme.surface;
        Text { text:"Pages"; color:Theme.text; font-size:18px; horizontal-alignment:center; vertical-alignment:center; }
        TouchArea { clicked=>{root.player-action("pages",0);} }
    }
    if root.activity-running && (root.player-shown || root.tv-shown) && !root.activity-busy: Rectangle {
        x: parent.width - 112px; y: 22px; width: 88px; height: 44px;
        background: #171717; border-radius: 22px;
        Text { text: "End"; color: #ffffff; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.end-activity(); } }
    }
    if root.activity-busy: Rectangle {
        width: parent.width; height: parent.height; background: #101010;
        VerticalLayout {
            padding: 36px; alignment: center; spacing: 20px;
            Text { text: root.activity-progress; color: #ffffff; font-size: 26px; wrap: word-wrap; horizontal-alignment: center; }
            Text { text: root.activity-step; color: #bbbbbb; font-size: 20px; horizontal-alignment: center; }
            Rectangle { height: 52px; border-radius: 26px; background: #292929;
                Text { text: "Cancel"; color: #ffffff; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.cancel-activity(); } }
            }
        }
    }

    wifi-setup := WifiSetup {
        x: root.wifi-setup-shown && !root.keyboard-shown ? 0px : root.width;
        y: root.status-h;
        width: root.width;
        height: root.height - root.status-h;
        shown: root.wifi-setup-shown && !root.keyboard-shown;
        title: root.wifi-setup-title;
        detail: root.wifi-setup-detail;
        qr: root.wifi-setup-qr;
        has-qr: root.wifi-setup-has-qr;
        items: root.wifi-setup-items;
        activate(i) => { root.wifi-setup-activate(i); }
        back => { root.wifi-setup-back(); }
    }

    if root.keyboard-shown: Keyboard {
        x: 0px;
        y: root.status-h;
        width: root.width;
        height: root.height - root.status-h;
        title: root.keyboard-title;
        placeholder: root.keyboard-placeholder;
        password: root.keyboard-password;
        accepted(t) => { root.keyboard-shown = false; fs.focus(); root.keyboard-accepted(t); }
        cancelled => { root.keyboard-shown = false; fs.focus(); root.keyboard-cancelled(); }
    }

    if root.settings-shown: Settings {
        x: 0px;
        y: root.status-h;
        width: root.width;
        height: root.height - root.status-h;
        shown: root.settings-shown;
        panel: root.settings-panel;
        brightness: root.setting-brightness;
        dim-choices: root.dim-choices;
        dim-index: root.dim-index;
        off-choices: root.off-choices;
        off-index: root.off-index;
        wifi-ssid: root.wifi-ssid;
        wifi-signal: root.wifi-signal;
        wifi-level: root.wifi-level;
        ssh-on: root.ssh-on;
        ssh-available: root.ssh-available;
        brightness-changed(v) => { root.setting-brightness = v; root.setting-brightness-changed(v); }
        dim-changed(i) => { root.dim-index = i; root.setting-dim-changed(i); }
        off-changed(i) => { root.off-index = i; root.setting-off-changed(i); }
        change-wifi => { root.setting-change-wifi(); }
        recovery-wifi => { root.setting-recovery-wifi(); }
        toggle-ssh => { root.setting-toggle-ssh(); }
        enter(n) => { root.settings-enter(n); }
        leave => { root.settings-leave(); }
    }

    MicOverlay {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        shown: root.recording;
        level: root.mic-level;
        latched: root.mic-latched;
    }

    PairOverlay {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        shown: root.pair-shown;
        pin: root.pair-pin;
        seconds-left: root.pair-seconds;
    }

    // A transient message near the bottom, above everything. The host sets the
    // text and clears it on a timer.
    if root.toast != "": Rectangle {
        x: 24px;
        width: parent.width - 48px;
        height: 56px;
        y: parent.height - self.height - 40px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-raised;
        border-radius: Theme.r-overlay;
        Text {
            width: parent.width - 32px;
            x: 16px;
            y: (parent.height - self.height) / 2;
            text: root.toast;
            font-size: 19px;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    VolumeOverlay {
        visible: root.feedback-enabled;
        x: Theme.overlay-inset;
        width: parent.width - 2 * Theme.overlay-inset;
        y: parent.height - self.height - Theme.overlay-inset;
        target: root.thermostat-feedback-name;
        caption: "Target";
        value-text: root.thermostat-feedback-value;
        meter: false;
        shown: root.thermostat-feedback-shown && root.light-shown && !root.chooser-shown && !root.thermostat-shown && !root.player-shown && !root.tv-shown;
    }
    VolumeOverlay {
        visible: root.feedback-enabled;
        x: Theme.overlay-inset;
        width: parent.width - 2 * Theme.overlay-inset;
        y: parent.height - self.height - Theme.overlay-inset;
        target: root.scene-feedback-name;
        caption: root.scene-feedback-status;
        meter: false;
        shown: root.scene-feedback-shown && !root.brightness-shown;
    }
    VolumeOverlay {
        visible: root.feedback-enabled;
        x: Theme.overlay-inset;
        width: parent.width - 2 * Theme.overlay-inset;
        y: parent.height - self.height - Theme.overlay-inset;
        target: root.brightness-target;
        caption: root.brightness-label;
        value: root.light-brightness-percent;
        percentage: true;
        shown: root.brightness-shown && root.light-shown && !root.chooser-shown;
    }
    VolumeOverlay {
        visible: root.feedback-enabled;
        x: Theme.overlay-inset;
        width: parent.width - 2 * Theme.overlay-inset;
        y: parent.height - self.height - Theme.overlay-inset;
        target: root.volume-target;
        value: root.volume;
        shown: root.volume-shown;
    }
    if root.dock-clock-shown: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #050505;
        Text {
            x: 24px;
            y: 300px + root.dock-clock-shift * 16px;
            width: parent.width - 48px;
            height: 100px;
            text: root.clock;
            font-size: 62px;
            font-weight: 600;
            color: #b4b4b4;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 24px;
            y: 420px + root.dock-clock-shift * 16px;
            width: parent.width - 48px;
            height: 32px;
            text: "Charging · " + root.battery + "%";
            font-size: 20px;
            color: #737373;
            horizontal-alignment: center;
        }
    }
}
