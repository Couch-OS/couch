import { Theme } from "../theme.slint";
export component MediaBack inherits Rectangle {
    callback activate();
    width:48px;height:48px;border-radius:14px;
    background:Theme.surface;border-width:1px;border-color:Theme.border-raised;
    Image {x:10.5px;y:10.5px;width:27px;height:27px;source:@image-url("../../../../assets/lucide/arrow-big-left.svg");colorize:Theme.text;}
    TouchArea {clicked=>{root.activate();}}
}
