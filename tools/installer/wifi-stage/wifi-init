#!/bin/busybox sh
# RAM-only network bootstrap. Never mount userdata or replay Android properties.
BB=/bin/busybox
umask 077
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
echo initializing > /tmp/couch-wifi.status
step() {
    echo "$1" > /tmp/couch-wifi.step
    echo "WiFi step: $1" >> /tmp/probe.log
}
fail() {
    echo "$1" > /tmp/couch-wifi.error
    echo failed > /tmp/couch-wifi.status
    echo "WiFi failed: $1" >> /tmp/probe.log
    exit 1
}
step detect
for spec in ttyMT1:210 ttyMT2:211 ttyMT3:212; do
    [ -e /dev/${spec%%:*} ] || $BB mknod /dev/${spec%%:*} c 204 ${spec##*:}
done
# mdev -s would expose writable block devices. Discover only required char nodes.
node() {
    major=$($BB awk -v name="$2" '$2==name {print $1;exit}' /proc/devices)
    case "$major" in ''|*[!0-9]*) return 1;; esac
    [ -e "/dev/$1" ] || $BB mknod -m 600 "/dev/$1" c "$major" 0
}
node wmtdetect mtk_wcn_detect || fail detect-node
for firmware in /vendor/firmware/*; do
    [ ! -f "$firmware" ] || $BB ln -s "$firmware" / 2>/dev/null
done
step loader
LD_LIBRARY_PATH=/system/lib:/vendor/lib /vendor/bin/wmt_loader >/tmp/wmt-loader.log 2>&1
loader_rc=$?
echo "WiFi loader exit: $loader_rc" >> /tmp/probe.log
# The pinned Android loader returns its final property_set() result, even
# after successful hardware detection. This RAM stage deliberately has no
# Android property service. Require the driver's post-detection registration
# instead; a missing transport still stops startup before any credentials.
if [ "$loader_rc" -ne 0 ]; then
    $BB awk '$2=="mtk_stp_wmt" {found=1} END {exit !found}' /proc/devices || fail loader-exit
    echo 'WiFi loader: transport registered despite Android exit status' >> /tmp/probe.log
fi
node stpwmt mtk_stp_wmt || fail transport-node
node wmtWifi mtk_wmt_WIFI_chrdev || fail wifi-node
step transport
# Only this process receives the bridge; the loader must detect hardware first.
wmt_preload=
[ ! -f /lib/couch-wmt-properties.so ] || wmt_preload=/lib/couch-wmt-properties.so
LD_PRELOAD="$wmt_preload" \
LD_LIBRARY_PATH=/system/lib:/vendor/lib:/system/lib/hw:/vendor/lib/hw \
    /vendor/bin/wmt_launcher -p /vendor/firmware/ >/tmp/wmt-launcher.log 2>&1 &
launcher=$!
n=0
while ! $BB dmesg | $BB grep -qE 'set STP mode success|wmt_lib_set_hif:new hifType'; do
    $BB kill -0 "$launcher" 2>/dev/null || fail launcher-exit
    [ "$n" -lt 20 ] || fail transport-timeout
    $BB sleep 1; n=$((n+1))
done
# Use driver default calibration behavior. No fabricated/persisted device identity.
step power
echo 1 > /dev/wmtWifi || fail power-on
n=0
while [ ! -d /sys/class/net/wlan0 ]; do
    [ "$n" -lt 15 ] || fail interface-timeout
    $BB sleep 1; n=$((n+1))
done
$BB ifconfig wlan0 up || fail interface-up
# Start one supplicant with no networks. Scans and provisioning share its PID.
printf 'ctrl_interface=/tmp/couch-wpa\nupdate_config=0\n' > /tmp/couch-wpa_supplicant.conf
/sbin/wpa_supplicant -i wlan0 -Dnl80211 -c /tmp/couch-wpa_supplicant.conf >/dev/null 2>&1 &
supplicant=$!
n=0
while [ ! -S /tmp/couch-wpa/wlan0 ]; do
    $BB kill -0 "$supplicant" 2>/dev/null || fail supplicant-exit
    [ "$n" -lt 10 ] || fail supplicant-exit
    $BB sleep 1; n=$((n+1))
done
step credentials
echo ready > /tmp/couch-wifi.status
while true; do
    $BB kill -0 "$supplicant" 2>/dev/null || fail supplicant-exit
    if [ -f /tmp/couch-wifi.request ] && [ -f /tmp/couch-wpa_supplicant.conf ]; then
        $BB rm -f /tmp/couch-wifi.request /tmp/couch-wifi.ip
        echo connecting > /tmp/couch-wifi.status
        step connect
        # The USB worker already reconfigured this supplicant and received OK.
        $BB udhcpc -i wlan0 -f -n -t 20 -T 3 -s /bin/couch-dhcp \
            >/dev/null 2>&1 &
        dhcp=$!
        while $BB kill -0 "$supplicant" 2>/dev/null && $BB kill -0 "$dhcp" 2>/dev/null; do
            $BB sleep 2
        done
        if $BB kill -0 "$supplicant" 2>/dev/null; then
            reason=dhcp-exit
        else
            reason=supplicant-exit
        fi
        $BB kill "$supplicant" "$dhcp" 2>/dev/null
        $BB rm -f /tmp/couch-wifi.ip
        fail "$reason"
    fi
    $BB sleep 1
done
