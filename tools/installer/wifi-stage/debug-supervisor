#!/bin/busybox sh
# Dedicated RAM-only Wi-Fi diagnostic loop. It accepts no shell text and never
# sees credentials: only the probe may create the fixed retry marker.
BB=/bin/busybox
umask 077
generation=0
MAX_GENERATIONS=8
retry_state=none

# This is the sole producer of lifecycle state consumed by the fixed debug
# probe. It never accepts a PID, command, path, or host input. Keep the line
# short and allowlisted so a partially written or corrupt RAM file fails closed
# to "unknown" in the probe instead of becoming a shell/control channel.
lifecycle() {
    printf 'supervisor=couch-wifi-debug-supervisor-v1 generation=%s phase=%s retry=%s marker=%s worker=%s worker_exit=%s\n' \
        "$generation" "$1" "$retry_state" "$2" "$3" "$4" > /tmp/couch-wifi-debug.lifecycle
}

worker_result() {
    case "$1" in
        0) echo success;;
        *) [ "$1" -ge 128 ] && echo signaled || echo failure;;
    esac
}

while true; do
    if [ "$generation" -ge "$MAX_GENERATIONS" ]; then
        echo debug-retry-limit > /tmp/couch-wifi.error
        echo failed > /tmp/couch-wifi.status
        echo 'WiFi failed: debug-retry-limit' > /tmp/couch-wifi-debug.log
        retry_state=limit
        lifecycle retry-limit absent exited none
        # Keep the diagnostic FunctionFS service alive, but never start a
        # ninth generation. A fresh reviewed debug transition is required.
        while true; do
            lifecycle retry-limit absent exited none
            $BB sleep 1
        done
    fi
    generation=$((generation + 1))
    echo "$generation" > /tmp/couch-wifi-debug.generation
    $BB rm -f /tmp/couch-wifi-debug.retry /tmp/couch-wifi.status /tmp/couch-wifi.error \
        /tmp/couch-wifi.ip /tmp/couch-wifi.request /tmp/couch-wpa_supplicant.conf \
        /tmp/couch-wpa_supplicant.conf.pending
    $BB rm -rf /tmp/couch-wpa
    : > /tmp/couch-wifi-debug.log
    : > /tmp/probe.log
    lifecycle generation-started absent starting none
    /bin/couch-wifi-init >> /tmp/couch-wifi-debug.log 2>&1 &
    worker=$!
    lifecycle worker-running absent running none
    while $BB kill -0 "$worker" 2>/dev/null; do
        if [ -f /tmp/couch-wifi-debug.retry ]; then
            # Fixed process names only; no host-provided command or path.
            retry_state=consumed
            lifecycle retry-consumed present running none
            $BB kill "$worker" 2>/dev/null
            break
        fi
        lifecycle worker-running absent running none
        $BB sleep 1
    done
    # On both ways out of the loop, not just the retry: a
    # supplicant-socket-timeout deliberately leaves the blocked wpa_supplicant
    # running after the worker is gone, and the next generation would race it
    # for the control socket.
    $BB killall wpa_supplicant wmt_launcher wmt_loader 2>/dev/null
    # `wait` is an ash builtin, not a BusyBox applet: `$BB wait` exited 127
    # without reaping anything, so every worker_exit read "failure" and the
    # retry loop below spun against a zombie.
    wait "$worker" 2>/dev/null
    result=$?
    if [ -f /tmp/couch-wifi-debug.retry ]; then
        retry_state=consumed
        lifecycle retry-consumed present exited "$(worker_result "$result")"
    else
        lifecycle waiting-retry absent exited "$(worker_result "$result")"
        while [ ! -f /tmp/couch-wifi-debug.retry ]; do
            lifecycle waiting-retry absent exited "$(worker_result "$result")"
            $BB sleep 1
        done
        retry_state=consumed
        lifecycle retry-consumed present exited "$(worker_result "$result")"
    fi
done
