{
  "protocol_version": 2,
  "id": "denon",
  "label": "Denon AVR",
  "version": "0.2.1",
  "executable": "bin/couch-plugin-denon",
  "capabilities": [
    {
      "id": "power-on",
      "label": "Main zone on"
    },
    {
      "id": "power-off",
      "label": "Main zone off"
    },
    {
      "id": "volume-up",
      "label": "Volume up (0.5 dB)"
    },
    {
      "id": "volume-down",
      "label": "Volume down (0.5 dB)"
    },
    {
      "id": "mute",
      "label": "Toggle mute"
    },
    {
      "id": "mute-on",
      "label": "Mute"
    },
    {
      "id": "mute-off",
      "label": "Unmute"
    }
  ],
  "settings": [
    {
      "id": "host",
      "label": "Device address",
      "kind": "text",
      "required": true
    },
    {
      "id": "port",
      "label": "Port",
      "kind": "integer",
      "required": true,
      "default": 23
    }
  ],
  "supports_inputs": true,
  "presentation": [
    {
      "kind": "toggle",
      "label": "Power",
      "state": "on",
      "on": "power-on",
      "off": "power-off"
    },
    {
      "kind": "command_group",
      "title": "Volume",
      "commands": [
        "volume-up",
        "volume-down"
      ]
    },
    {
      "kind": "status_text",
      "label": "Volume",
      "field": "volume_db"
    },
    {
      "kind": "volume_db_control",
      "label": "Set volume"
    },
    {
      "kind": "toggle",
      "label": "Mute",
      "state": "muted",
      "on": "mute-on",
      "off": "mute-off"
    },
    {
      "kind": "input_selector",
      "label": "Source"
    }
  ],
  "min_core_protocol_version": 2,
  "actions": [
    {
      "action": "set_volume_db",
      "min_tenths": -800,
      "max_tenths": 180,
      "step_tenths": 5
    }
  ]
}
