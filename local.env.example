# Copy to local.env and set only the controls used by this workstation.  Values
# can be literal shell words or one quoted literal; shell expansions are not read
# by tools that inspect this file directly.
# local.env is ignored; do not commit host names, paths, or credentials.
#
# KERNEL_BUILD_MODE=remote
# KERNEL_REMOTE_HOST=builder.example.invalid
# KERNEL_REMOTE_RECIPE_ROOT=/srv/couch/kernel-recipe
# KTREE=/srv/couch-kernel/base
# KBUILD_BUILD_HOST=historical-builder-name
# SER_HOST=local
# SER_PORT=/dev/ttyACM0
