#!/bin/busybox sh
# Couch - Linux for the Sanytron Astrion HA100 (MT6580).
# first stage.
#
# Deliberately minimal and stable: bring up enough to get a shell and a screen,
# then hand off to stage2 on the Alpine partition. stage2 can be replaced with
# tools/push.py over the serial link and re-run with tools/relinux.sh, so the
# slow path (rebuild -> adb -> reflash -> reboot through Android) is only needed
# when this file, the kernel or fbcon change.
#
# If stage2 is missing or broken there is still a shell, which is the whole
# point of keeping it out of here.
#
# There is no CONFIG_VT, so the kernel gives us no console: fbcon draws our
# stdout to the panel, which is why the body runs piped into it.

BB=/bin/busybox
LOG=/dev/mmcblk0p13      # expdb: scratch for markers and logs
# Markers used to sit at sector 0. That put them directly under MTK's crash
# dump: on any watchdog reset the MRDUMP header and section table are written
# over the first sectors of expdb, so the one boot whose markers we most want
# to read is exactly the boot that destroys them. MTK's own sections end around
# 6.3MB, so everything of ours now lives above sector 13000. Keep in step with
# MARKER_SECTOR / DMESG_SECTOR in tools/env.sh. init owns BASE+0..5 and
# BASE+39..41; stage2 owns BASE+6..12 (its own BASE is 13006). Keep out of
# each other's range - markers that collide silently overwrite each other,
# and the one you lose is the one you added to answer the current question.
BASE=13000
DMESG_SECTOR=13064
AUSB=/sys/class/android_usb/android0
ALPINE=/mnt/alpine

mark() { $BB echo "$2" | $BB dd of=$LOG bs=512 seek=$1 count=1 conv=notrunc 2>/dev/null; }

main() {
    trap '' PIPE

    # Arm the way back before doing anything that can hang. With the BCB set,
    # lk boots the recovery slot, so a kernel that dies takes the watchdog reset
    # into recovery instead of looping on a bad image forever - which is what
    # made every failed experiment need a person to power cycle the device.
    # A full 512-byte block, so no stale bytes trail the command string.
    { $BB printf "boot-recovery"; $BB dd if=/dev/zero bs=499 count=1 2>/dev/null; } \
        | $BB dd of=/dev/mmcblk0p10 bs=512 count=1 conv=notrunc 2>/dev/null

    # Confirm local GUI progress, not elapsed time or Internet availability.
    # A rendered frame and three advancing heartbeats from the same process
    # must be observed. A dead/hung GUI preserves the recovery request.
    ( $BB sleep 90
      healthy_pid=0; healthy_stamp=0; streak=0; tries=0
      while [ "$tries" -lt 12 ]; do
          tries=$((tries+1))
          if record=$($BB sh /extra/boot-health.sh 2>/dev/null); then
              set -- $record
              if [ "$1" = "$healthy_pid" ] && [ "$2" -gt "$healthy_stamp" ]; then
                  streak=$((streak+1))
              else
                  streak=1
              fi
              healthy_pid=$1; healthy_stamp=$2
              if [ "$streak" -ge 3 ] &&
                 $BB dd if=/dev/zero of=/dev/mmcblk0p10 bs=512 count=1 conv=notrunc 2>/dev/null; then
                  $BB sync
                  mark $((BASE+40)) "S10 local GUI healthy, bcb cleared"
                  exit 0
              fi
          else
              streak=0
          fi
          $BB sleep 5
      done
      mark $((BASE+40)) "S10 GUI unhealthy, rebooting with recovery BCB armed"
      $BB sync
      $BB reboot -f ) &

    for c in 1 2 3; do $BB echo 1 > /sys/devices/system/cpu/cpu$c/online 2>/dev/null; done
    echo "= cpus $($BB nproc)  mem $($BB free | $BB awk '/Mem:/{print int($4/1024)}')MB free"
    mark $((BASE+1)) "S1 core up"

    # Heartbeat: one sector, rewritten each second with the uptime. USB staying
    # enumerated is not evidence the kernel is alive - the gadget can stay up
    # through a hang - so this is what separates "hung early" from "ran to the
    # watchdog timeout and was reset". Bounded, like the snapshots below.
    ( h=0
      while [ $h -lt 60 ]; do
          h=$((h+1))
          mark $((BASE+39)) "alive ${h} at $($BB cut -d" " -f1 /proc/uptime)s"
          $BB sleep 1
      done ) &

    # Snapshot the kernel log where a reset cannot erase it. A kernel that dies
    # mid-boot leaves nothing on the serial gadget (it is not up yet) and
    # nothing in /proc/last_kmsg (that needs a later boot to read it, and the
    # RAM console does not survive the power cycle a recovery flash needs), so
    # this is the only log that outlives the failure. Bounded to the first
    # minute: it is a bring-up aid, not something worth writing to eMMC forever.
    # Rotate over four slots, one a second: a single slot only ever holds the
    # last completed write, and when the system dies mid-boot that is several
    # seconds stale - exactly the seconds worth reading. Four slots of 256KB
    # each sit between DMESG_SECTOR and DMESG2_SECTOR.
    ( n=0
      while [ $n -lt 60 ]; do
          n=$((n+1))
          { $BB echo "== snapshot $n at $($BB cut -d" " -f1 /proc/uptime)s =="; $BB dmesg; } \
              | $BB dd of=$LOG bs=512 seek=$((DMESG_SECTOR + (n % 4) * 512)) conv=notrunc 2>/dev/null
          $BB sleep 1
      done ) &

    ( $BB sleep 900; [ -f /tmp/stay ] || $BB reboot -f ) &

    # --- Alpine rootfs ----------------------------------------------------------
    # Already mounted, before the console started - see the bottom of this file.
    # Only the bind mounts and the reporting are left to do here.
    if [ "$HAVE_ALPINE" = yes ]; then
        $BB mkdir -p $ALPINE/proc $ALPINE/sys $ALPINE/dev $ALPINE/tmp $ALPINE/opt/couch
        $BB mount -t proc proc $ALPINE/proc 2>/dev/null
        $BB mount -t sysfs sysfs $ALPINE/sys 2>/dev/null
        $BB mount -o bind /dev $ALPINE/dev 2>/dev/null
        $BB mount -o bind /tmp $ALPINE/tmp 2>/dev/null
        echo "= alpine $($BB cat $ALPINE/etc/alpine-release) on $ALPINE"
    else
        echo "= alpine FAIL: no rootfs on userdata"
    fi
    mark $((BASE+2)) "S2 alpine=$HAVE_ALPINE"

    # --- USB serial shell -------------------------------------------------------
    $BB echo 1 > /sys/devices/platform/mt_usb/cmode 2>/dev/null
    $BB echo 0 > $AUSB/enable 2>/dev/null
    $BB echo 1 > $AUSB/f_acm/instances 2>/dev/null   # 0 by default = no endpoints
    $BB echo 0e8d > $AUSB/idVendor 2>/dev/null
    $BB echo 201c > $AUSB/idProduct 2>/dev/null
    $BB echo acm > $AUSB/functions 2>/dev/null
    $BB echo 1 > $AUSB/enable 2>/dev/null
    # ttyGS0's major is allocated dynamically when the gadget serial driver
    # registers, so the 233 baked into the initramfs (read once off the running
    # Android) is only right by luck. A kernel built with a different set of
    # drivers gets a different number, and then the node points at nothing: the
    # gadget still enumerates, so the host sees a port, but every open fails and
    # the shell dies instantly - which looks exactly like a hung kernel and
    # costs a power cycle to escape. Read the real major and remake the node.
    GSMAJ=$($BB awk '$2 == "ttyGS" { print $1 }' /proc/devices | $BB head -1)
    if [ -n "$GSMAJ" ]; then
        $BB rm -f /dev/ttyGS0
        $BB mknod /dev/ttyGS0 c "$GSMAJ" 0
    fi
    mark $((BASE+41)) "S11 ttyGS major=${GSMAJ:-none}"
    echo "= ttyGS0 major ${GSMAJ:-NOT FOUND}"

    # The serial shell is the way back in when nothing else works, so it runs the
    # initramfs busybox rather than the Alpine chroot. The chroot needs the
    # rootfs mounted and /dev and /proc bound inside it, and any of that failing
    # left the gadget enumerated with nothing answering - which from the host is
    # indistinguishable from a hung kernel, and cost a physical power cycle to
    # get out of. Busybox here depends on nothing but the initramfs. Alpine is
    # one `chroot /mnt/alpine /bin/sh` away once you are in.
    #
    # Two independent respawn loops, because a single one that dies takes the
    # only way in with it.
    ( while true; do $BB sh </dev/ttyGS0 >/dev/ttyGS0 2>&1; $BB sleep 1; done ) &
    ( while true; do
          $BB sleep 20
          $BB pgrep -f "busybox sh" >/dev/null 2>&1 && continue
          $BB sh </dev/ttyGS0 >/dev/ttyGS0 2>&1
      done ) &
    echo "= shell: busybox on usb serial (alpine at /mnt/alpine)"
    mark $((BASE+3)) "S3 shell up"

    # --- hand off to the pushable stage -----------------------------------------
    S2=$ALPINE/opt/couch/stage2.sh
    mark $((BASE+4)) "S4 stage2 start"
    if [ -f "$S2" ]; then
        $BB sh "$S2"
    else
        echo "= no stage2 at $S2 (push one with tools/push.py)"
    fi
    mark $((BASE+5)) "S5 stage2 done"

    echo ""
    echo "= first stage done, holding."
    while true; do $BB sleep 3600; done
}

mark $((BASE+0)) "S0 init entered"

# Everything the console itself depends on has to be up before the pipeline
# below starts, because main() is the left-hand side of that pipe. Mounting the
# rootfs here is what lets a bundled fbcon be chosen at all: this test used to
# run with /mnt/alpine unmounted and was never once true, so the copy baked into
# the initramfs always won and pushing a new fbcon did nothing.
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t tmpfs tmpfs /tmp
$BB --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# The panel switches its own backlight off when idle; hold it on quietly. The
# old heartbeat kept the screen alive only as a side effect of blinking it.
# This has to sit below the mounts: the pid file used to be written before the
# tmpfs went on /tmp, so the runtime saw an empty /tmp and gui-start.sh always
# fell back to its process-shape scan instead of the pid (#134/#135). The first
# brightness write also needs /sys.
( while true; do
    $BB echo 255 > /sys/class/leds/lcd-backlight/brightness 2>/dev/null
    $BB echo 255 > /sys/class/leds/button-backlight/brightness 2>/dev/null
    $BB sleep 5
  done ) &
# So the runtime can stop it by pid rather than by guessing its shape
# (stage2/gui-start.sh). /tmp is shared with the rootfs.
echo $! > /tmp/backlight-keeper.pid

$BB mkdir -p $ALPINE
if $BB mount -t ext4 /dev/mmcblk0p23 $ALPINE 2>/dev/null &&
   [ -f $ALPINE/etc/alpine-release ]; then
    HAVE_ALPINE=yes
else
    HAVE_ALPINE=no
fi

FBCON=/extra/fbcon
[ -x $ALPINE/opt/couch/fbcon ] && FBCON=$ALPINE/opt/couch/fbcon

# An appliance shows a logo, not shell narration, so the panel is quiet by
# default. Create /opt/couch/verbose on the rootfs to watch a boot; either way
# the same output still reaches the USB serial console and the offline markers,
# so nothing is lost for debugging.
FBOPT=-q
[ -f $ALPINE/opt/couch/verbose ] && FBOPT=-v

main 2>&1 | $FBCON $FBOPT /dev/fb0
while true; do $BB sleep 3600; done
